<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    MSI für die Auswerte-App (spec 4.1): Riegel.exe, Riegel.Cli.exe, collector\ (Sammler-Paket), LICENSE und
    THIRD-PARTY-NOTICES.txt aus $(PublishDir). Für Admin-, Engineering- und Prüfer-PCs und IT-verwaltete Rechner –
    nicht der Weg auf OT- oder validierte Rechner (dort der portable Sammler). Bauen:
      dotnet publish src/Riegel/Riegel.csproj -c Release -r win-x64 -p:PublishSingleFile=true -p:SelfContained=true -o publish
      dotnet publish src/Riegel.Cli/Riegel.Cli.csproj -c Release -f net10.0-windows -r win-x64 -p:PublishSingleFile=true -p:SelfContained=true -o publish
      (Sammler-Paket nach publish/collector)
      dotnet build installer/Riegel.Installer.wixproj -c Release -p:ProductVersion=1.0.1

    WiX Toolset 5.0.2 und WixToolset.Util.wixext 5.0.2, MS-RL – nur zum Bauen; die Custom Action von
    util:CloseApplication steckt in der MSI (THIRD-PARTY-NOTICES.txt). Ab 6.0 gilt die OSMF-EULA, Dependabot ignoriert
    Major-Sprünge. https://api.nuget.org/v3-flatcontainer/wixtoolset.sdk/5.0.2/wixtoolset.sdk.nuspec (gesehen 2026-10-18)
  -->
  <PropertyGroup>
    <OutputName>Riegel</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.1</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\publish\</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);AssetsDir=$(MSBuildThisFileDirectory)..\src\Riegel\Assets</DefineConstants>
    <Cultures>de-DE</Cultures>
    <!-- ICE38/43/57 schlagen bei Startmenü-Verknüpfungen in perMachine-Paketen fälschlich an (ALLUSERS=1 → Startmenü aller Benutzer).
         ICE61 warnt vor AllowSameVersionUpgrades, das ist hier gewollt (siehe Package.wxs).
         ICE60 bemängelt native DLLs ohne Sprache in der Versionsinfo – für Programm-DLLs bedeutungslos. -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE60;ICE61</SuppressIces>
    <!-- ICE-Prüfungen brauchen den Windows Installer-Dienst; auf CI-Runnern unnötig langsam/fehleranfällig -->
    <SuppressValidation Condition="'$(CI)' == 'true'">true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
