{
  "schema": "riegel.rules/1",
  "prefix": "URA",
  "rules": [
    {
      "id": "URA-02",
      "since": "2026.10",
      "state": "active",
      "category": "userRights",
      "severity": "medium",
      "kind": "check",
      "title": {
        "en": "Local accounts are denied network logon",
        "de": "Lokalen Konten ist die Netzwerkanmeldung verweigert"
      },
      "rationale": {
        "en": "On domain-joined machines, local accounts are the usual path for lateral movement with a shared password. The right \"Deny access to this computer from the network\" must contain \"Local account\" (S-1-5-113) or, as DISA allows on member servers, \"Local account and member of Administrators group\" (S-1-5-114). Workgroup machines have only local accounts, so the rule does not apply there.",
        "de": "Auf Domänenrechnern sind lokale Konten mit gemeinsamem Kennwort der übliche Weg für seitliche Bewegung. Das Recht „Zugriff vom Netzwerk auf diesen Computer verweigern“ muss „Lokales Konto“ (S-1-5-113) enthalten oder, wie DISA bei Mitgliedsservern zulässt, „Lokales Konto und Mitglied der Gruppe Administratoren“ (S-1-5-114). Arbeitsgruppenrechner haben nur lokale Konten; dort gilt die Regel nicht."
      },
      "otNote": {
        "en": "Vendor tools that copy data over SMB with a local account stop working; give them a domain service account or record an exception.",
        "de": "Herstellerwerkzeuge, die mit einem lokalen Konto Daten über SMB kopieren, funktionieren danach nicht mehr; ihnen ein Domänendienstkonto geben oder eine Ausnahme anlegen."
      },
      "remedy": {
        "en": "Add \"Local account\" (or \"Local account and member of Administrators group\") to \"Deny access to this computer from the network\".",
        "de": "„Lokales Konto“ (oder „Lokales Konto und Mitglied der Gruppe Administratoren“) zu „Zugriff vom Netzwerk auf diesen Computer verweigern“ hinzufügen."
      },
      "suggestedReason": "technicalNecessity",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "joined",
        "excludeDc": true,
        "when": []
      },
      "needsAdmin": true,
      "check": {
        "type": "anyOf",
        "checks": [
          {
            "type": "userRight",
            "right": "SeDenyNetworkLogonRight",
            "mode": "mustInclude",
            "sids": [
              "S-1-5-113"
            ]
          },
          {
            "type": "userRight",
            "right": "SeDenyNetworkLogonRight",
            "mode": "mustInclude",
            "sids": [
              "S-1-5-114"
            ]
          }
        ]
      },
      "remediation": {
        "securityTemplate": [
          {
            "section": "Privilege Rights",
            "key": "SeDenyNetworkLogonRight",
            "sids": [
              "*S-1-5-32-546",
              "*S-1-5-113"
            ]
          }
        ]
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "User rights policies",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
        },
        {
