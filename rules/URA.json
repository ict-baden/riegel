    {
      "id": "URA-05",
      "since": "2026.10",
      "state": "active",
      "category": "userRights",
      "severity": "high",
      "kind": "check",
      "title": {
        "en": "Only Administrators may debug programs",
        "de": "Nur Administratoren dürfen Programme debuggen"
      },
      "rationale": {
        "en": "The debug privilege lets a process read and change the memory of any other process, including LSASS, and is the standard tool for credential theft. \"Debug programs\" may be granted to Administrators only, or to nobody. A name in the security template that is not resolved to a SID makes the result not checkable.",
        "de": "Das Debug-Recht erlaubt einem Prozess, den Speicher jedes anderen Prozesses einschließlich LSASS zu lesen und zu ändern; es ist das Standardwerkzeug für Diebstahl von Anmeldedaten. „Programme debuggen“ darf nur Administratoren oder niemandem zugewiesen sein. Ein nicht in eine SID aufgelöster Name in der Sicherheitsvorlage macht das Ergebnis nicht prüfbar."
      },
      "otNote": {
        "en": "Development and diagnostic tools of plant software sometimes ask for the debug right for their service account. Grant it only temporarily for a diagnosis and record that.",
        "de": "Entwicklungs- und Diagnosewerkzeuge von Anlagensoftware verlangen teils das Debug-Recht für ihr Dienstkonto. Es nur vorübergehend für eine Diagnose vergeben und das festhalten."
      },
      "remedy": {
        "en": "Assign \"Debug programs\" to Administrators only.",
        "de": "„Programme debuggen“ nur Administratoren zuweisen."
      },
      "suggestedReason": "vendorRequirement",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": true,
      "check": {
        "type": "userRight",
        "right": "SeDebugPrivilege",
        "mode": "onlyFrom",
        "sids": [
          "S-1-5-32-544"
        ]
      },
      "remediation": {
        "securityTemplate": [
          {
            "section": "Privilege Rights",
            "key": "SeDebugPrivilege",
            "sids": [
              "*S-1-5-32-544"
            ]
          }
        ]
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "User rights policies",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
        },
        {
          "src": "MSB",
          "doc": "Windows 11 v26H2 Security Baseline v2",
          "setting": "Debug programs"
        },
        {
          "src": "DISA",
          "doc": "Microsoft Windows 11 STIG",
          "section": "V-253490",
          "id": "WN11-UR-000065",
          "url": "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_Windows_11_V2R11_STIG.zip",
          "version": "V2R11"
        },
        {
