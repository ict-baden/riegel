          "doc": "Microsoft Windows Server 2022 STIG",
          "section": "V-254500",
          "id": "WN22-UR-000100",
          "url": "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_Windows_Server_2022_V2R11_STIG.zip",
          "version": "V2R11"
        },
