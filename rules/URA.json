    {
      "id": "URA-03",
      "since": "2026.10",
      "state": "active",
      "category": "userRights",
      "severity": "medium",
      "kind": "check",
      "title": {
        "en": "Local accounts are denied Remote Desktop logon",
        "de": "Lokalen Konten ist die Remotedesktop-Anmeldung verweigert"
      },
      "rationale": {
        "en": "A local account that may sign in through Remote Desktop gives an attacker with its password an interactive session on the machine. On domain-joined machines the right \"Deny log on through Remote Desktop Services\" must contain \"Local account\" (S-1-5-113). Workgroup machines are excluded because their remote access depends on local accounts.",
        "de": "Ein lokales Konto, das sich per Remotedesktop anmelden darf, verschafft einem Angreifer mit seinem Kennwort eine interaktive Sitzung. Auf Domänenrechnern muss das Recht „Anmelden über Remotedesktopdienste verweigern“ „Lokales Konto“ (S-1-5-113) enthalten. Arbeitsgruppenrechner sind ausgenommen, weil ihr Fernzugang an lokalen Konten hängt."
      },
      "otNote": {
        "en": "Remote maintenance by the machine builder over RDP with a local account is common. Move it to personal domain accounts or a jump host, or record an exception.",
        "de": "Fernwartung des Anlagenbauers per RDP mit einem lokalen Konto ist üblich. Auf persönliche Domänenkonten oder einen Sprungserver umstellen oder eine Ausnahme anlegen."
      },
      "remedy": {
        "en": "Add \"Local account\" to \"Deny log on through Remote Desktop Services\".",
        "de": "„Lokales Konto“ zu „Anmelden über Remotedesktopdienste verweigern“ hinzufügen."
      },
      "suggestedReason": "vendorRequirement",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "joined",
        "excludeDc": true,
        "when": []
      },
      "needsAdmin": true,
      "check": {
        "type": "userRight",
        "right": "SeDenyRemoteInteractiveLogonRight",
        "mode": "mustInclude",
        "sids": [
          "S-1-5-113"
        ]
      },
      "remediation": {
        "securityTemplate": [
          {
            "section": "Privilege Rights",
            "key": "SeDenyRemoteInteractiveLogonRight",
            "sids": [
              "*S-1-5-32-546",
              "*S-1-5-113"
            ]
          }
        ]
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "Remote Desktop Services",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
        },
        {
