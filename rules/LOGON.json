                    "v": 1
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "notApplicable"
        }
      ]
    },
    {
      "id": "LOGON-10",
      "since": "2026.10",
      "state": "active",
      "category": "logon",
      "severity": "high",
      "kind": "check",
      "title": {
        "en": "No automatic logon",
        "de": "Keine automatische Anmeldung"
      },
      "rationale": {
        "en": "With AutoAdminLogon = 1 Windows signs in an account at every start without anyone entering a password, so everyone with physical access works under that account. The password is stored either in the registry (DefaultPassword, readable remotely by authenticated users) or as an LSA secret that administrators can decrypt. The rule fails whenever AutoAdminLogon is 1, whether or not DefaultPassword exists.",
        "de": "Mit AutoAdminLogon = 1 meldet Windows bei jedem Start ein Konto an, ohne dass jemand ein Kennwort eingibt; jeder mit physischem Zugang arbeitet dann unter diesem Konto. Das Kennwort liegt entweder in der Registry (DefaultPassword, für angemeldete Benutzer auch aus der Ferne lesbar) oder als LSA-Geheimnis, das Administratoren entschlüsseln können. Die Regel schlägt immer fehl, wenn AutoAdminLogon 1 ist, unabhängig von DefaultPassword."
      },
      "otNote": {
        "en": "Operator stations and kiosk HMIs often sign in automatically so that the plant software starts after a power failure. Keep this as an exception with compensating measures: a dedicated account without administrator rights, a locked-down shell, no network shares and physical protection.",
        "de": "Bedienstationen und Kiosk-HMIs melden sich oft automatisch an, damit die Anlagensoftware nach einem Stromausfall startet. Das als Ausnahme mit ausgleichenden Maßnahmen führen: eigenes Konto ohne Administratorrechte, abgeschottete Oberfläche, keine Netzfreigaben und physischer Schutz."
      },
      "remedy": {
        "en": "Set AutoAdminLogon to 0 and delete DefaultPassword; with Sysinternals Autologon use its disable option to remove the LSA secret.",
        "de": "AutoAdminLogon auf 0 setzen und DefaultPassword löschen; bei Sysinternals Autologon dessen Abschaltfunktion nutzen, um das LSA-Geheimnis zu entfernen."
      },
      "suggestedReason": "technicalNecessity",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon",
        "value": "AutoAdminLogon",
        "valueType": "sz",
        "op": "ne",
        "expected": "1",
        "whenMissing": "pass",
        "missingPass": {
          "source": "https://learn.microsoft.com/en-us/troubleshoot/windows-server/user-profiles-and-logon/turn-on-automatic-logon",
          "seen": "2026-10-18",
          "note": "Automatic logon requires AutoAdminLogon = 1; without the value Windows does not sign in automatically."
        }
      },
      "remediation": {
        "registry": [
          {
            "key": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon",
            "value": "AutoAdminLogon",
            "type": "sz",
            "data": "0"
          },
          {
            "key": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon",
            "value": "DefaultPassword",
            "delete": true
          }
        ]
      },
      "references": [
        {
          "src": "GSPP",
          "ids": [
            "KONF.5.1",
            "BER.3.16"
          ],
          "version": "2026-09-24"
        },
        {
          "src": "ATTACK",
          "ids": [
            "M1027",
            "M0927"
          ],
          "url": "https://attack.mitre.org/mitigations/enterprise/",
          "version": "v20.0"
        }
      ],
      "textSources": [],
      "verified": [
        {
          "src": "MSLEARN-FACT",
          "url": "https://learn.microsoft.com/en-us/troubleshoot/windows-server/user-profiles-and-logon/turn-on-automatic-logon",
          "date": "2026-10-18",
          "note": "Autologon is a security risk: anyone with physical access gains the account; the password is stored in the registry in plain text and can be read remotely by Authenticated Users; AutoAdminLogon 1 enables it."
        },
        {
          "src": "MSLEARN-FACT",
          "url": "https://learn.microsoft.com/en-us/sysinternals/downloads/autologon",
          "date": "2026-10-18",
          "note": "Sysinternals Autologon stores the password as an LSA secret, which an administrator can easily retrieve and decrypt."
        }
      ],
      "tests": [
        {
          "name": "Automatic logon off",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon": {
              "status": "ok",
              "value": {
                "values": {
                  "AutoAdminLogon": {
                    "t": "sz",
                    "v": "0"
                  },
                  "DefaultUserName": {
                    "t": "sz",
                    "v": "bediener"
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "pass"
        },
        {
          "name": "Automatic logon with password in the registry",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon": {
              "status": "ok",
              "value": {
                "values": {
                  "AutoAdminLogon": {
                    "t": "sz",
                    "v": "1"
                  },
                  "DefaultUserName": {
                    "t": "sz",
                    "v": "bediener"
                  },
                  "DefaultPassword": {
                    "t": "sz",
                    "redacted": true,
                    "empty": false
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "fail"
        },
        {
          "name": "Automatic logon without DefaultPassword (LSA secret)",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon": {
              "status": "ok",
              "value": {
                "values": {
                  "AutoAdminLogon": {
                    "t": "sz",
                    "v": "1"
                  },
                  "DefaultUserName": {
                    "t": "sz",
                    "v": "bediener"
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "fail"
        },
        {
          "name": "Value missing (no automatic logon)",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon": {
              "status": "valueMissing",
              "value": {
                "values": {
                  "DefaultUserName": {
                    "t": "sz",
                    "v": "bediener"
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "pass",
          "expectFlags": [
            "fromDefault"
          ]
        },
        {
          "name": "Key not collected",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon": {
              "status": "notCollected"
            }
          },
          "expect": "notCheckable"
        },
        {
          "name": "Wrong value type",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon": {
              "status": "ok",
              "value": {
                "values": {
                  "AutoAdminLogon": {
                    "t": "dword",
                    "v": 1
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "fail"
        }
      ]
    }
  ]
}
