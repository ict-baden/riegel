{
  "schema": "riegel.rules/1",
  "prefix": "LOGON",
  "rules": [
    {
      "id": "LOGON-09",
      "since": "2026.10",
      "state": "active",
      "category": "logon",
      "severity": "medium",
      "kind": "check",
      "title": {
        "en": "Machine locks after at most 15 minutes of inactivity",
        "de": "Rechner sperrt nach höchstens 15 Minuten Inaktivität"
      },
      "rationale": {
        "en": "An unlocked, unattended session lets anyone act under the signed-in account. The policy \"Interactive logon: Machine inactivity limit\" must be between 1 and 900 seconds; 0 or a missing value means the machine never locks by itself. The setting exists from Windows 8 and Server 2012.",
        "de": "Eine entsperrte, unbeaufsichtigte Sitzung erlaubt jedem, unter dem angemeldeten Konto zu handeln. Die Richtlinie „Interaktive Anmeldung: Inaktivitätsgrenze des Computers“ muss zwischen 1 und 900 Sekunden liegen; 0 oder ein fehlender Wert bedeutet, dass der Rechner sich nicht selbst sperrt. Die Einstellung gibt es ab Windows 8 und Server 2012."
      },
      "otNote": {
        "en": "Operator displays in control rooms must stay visible and must not lock in the middle of production. Cover them by tailoring for the HMI role (physical access control of the control room) rather than by an exception.",
        "de": "Bedienbilder in Leitständen müssen sichtbar bleiben und dürfen nicht mitten in der Produktion sperren. Sie über den Zuschnitt der Rolle HMI abdecken (Zutrittsschutz des Leitstands) statt über eine Ausnahme."
      },
      "remedy": {
        "en": "Set \"Interactive logon: Machine inactivity limit\" to 900 seconds or less.",
        "de": "„Interaktive Anmeldung: Inaktivitätsgrenze des Computers“ auf 900 Sekunden oder weniger setzen."
      },
      "suggestedReason": "technicalNecessity",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "minBuild": 9200,
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "allOf",
        "checks": [
          {
            "type": "registry",
            "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "value": "InactivityTimeoutSecs",
            "valueType": "dword",
            "op": "ge",
            "expected": 1,
            "whenMissing": "fail"
          },
          {
            "type": "registry",
            "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "value": "InactivityTimeoutSecs",
            "valueType": "dword",
            "op": "le",
            "expected": 900,
            "whenMissing": "fail"
          }
        ]
      },
      "remediation": {
        "registry": [
          {
            "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "value": "InactivityTimeoutSecs",
            "type": "dword",
            "data": 900
          }
        ]
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "Session locking",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
        },
        {
          "src": "MSB",
          "doc": "Windows 11 v26H2 Security Baseline v2",
          "setting": "Interactive logon: Machine inactivity limit"
        },
        {
          "src": "DISA",
          "doc": "Microsoft Windows 11 STIG",
          "section": "V-253444",
          "id": "WN11-SO-000070",
          "url": "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_Windows_11_V2R11_STIG.zip",
          "version": "V2R11"
        },
        {
          "src": "DISA",
          "doc": "Microsoft Windows Server 2022 STIG",
          "section": "V-254456",
          "id": "WN22-SO-000120",
          "url": "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_Windows_Server_2022_V2R11_STIG.zip",
          "version": "V2R11"
        },
        {
          "src": "DISA",
          "doc": "Microsoft Windows Server 2025 STIG",
          "section": "V-278206",
          "id": "WN25-SO-000120",
          "url": "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_Windows_Server_2025_V1R4_STIG.zip",
          "version": "V1R4"
        },
        {
          "src": "GSPP",
          "ids": [
            "BER.3.12"
          ],
          "version": "2026-09-24"
        }
      ],
      "textSources": [],
      "verified": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations",
          "date": "2026-10-18",
          "section": "Session locking",
          "note": "Interactive logon: Machine inactivity limit: 900 seconds."
        },
        {
          "src": "DISA",
          "doc": "U_MS_Windows_11_STIG_V2R11_Manual-xccdf.xml (Release 11, benchmark date 30 Sep 2026)",
          "url": "https://dl.dod.cyber.mil/wp-content/uploads/stigs/zip/U_MS_Windows_11_V2R11_STIG.zip",
          "date": "2026-10-18",
          "section": "WN11-SO-000070 (V-253444, CAT II)",
          "note": "Policies\\System InactivityTimeoutSecs REG_DWORD 900 or less, excluding 0."
        },
        {
          "src": "MSLEARN-FACT",
          "url": "https://learn.microsoft.com/en-us/previous-versions/windows/it-pro/windows-10/security/threat-protection/security-policy-settings/interactive-logon-machine-inactivity-limit",
          "date": "2026-10-18",
          "note": "Default on all server types and client computers: Disabled; introduced in Windows Server 2012 and Windows 8."
        }
      ],
      "tests": [
        {
          "name": "900 seconds",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System": {
              "status": "ok",
              "value": {
                "values": {
                  "InactivityTimeoutSecs": {
                    "t": "dword",
                    "v": 900
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "pass"
        },
        {
