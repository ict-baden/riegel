            "build": 20348,
            "ubr": 4294,
            "edition": "ServerStandard",
            "installationType": "Server",
            "productType": 3,
            "domainRole": 3,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System": {
              "status": "ok",
              "value": {
                "values": {
                  "InactivityTimeoutSecs": {
                    "t": "dword",
                    "v": 600
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "pass"
        },
        {
