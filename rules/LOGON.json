          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System": {
              "status": "ok",
              "value": {
                "values": {
                  "InactivityTimeoutSecs": {
                    "t": "dword",
                    "v": 0
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "fail"
        },
        {
          "name": "1800 seconds",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System": {
              "status": "ok",
              "value": {
                "values": {
                  "InactivityTimeoutSecs": {
                    "t": "dword",
                    "v": 1800
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "fail"
        },
        {
          "name": "Value missing",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System": {
              "status": "valueMissing",
              "value": {
                "values": {
                  "EnableLUA": {
                    "t": "dword",
                    "v": 1
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "fail"
        },
        {
          "name": "Key not collected",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System": {
              "status": "notCollected"
            }
          },
          "expect": "notCheckable"
        },
        {
          "name": "Windows 7: setting does not exist",
          "machine": {
            "build": 7601,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
