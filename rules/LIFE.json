    {
      "id": "LIFE-05",
      "since": "2026.10",
      "state": "active",
      "category": "lifecycle",
      "severity": "medium",
      "kind": "check",
      "title": {
        "en": "64-bit edition of Windows",
        "de": "64-Bit-Ausgabe von Windows"
      },
      "rationale": {
        "en": "64-bit Windows enforces driver signing, kernel patch protection and hardware DEP, which 32-bit Windows lacks. Riegel reads the system environment variable PROCESSOR_ARCHITECTURE from the registry; AMD64, ARM64 and IA64 are 64-bit, x86 is 32-bit.",
        "de": "64-Bit-Windows erzwingt Treibersignaturen, Kernel-Patch-Schutz und Hardware-DEP, die 32-Bit-Windows fehlen. Riegel liest die Systemumgebungsvariable PROCESSOR_ARCHITECTURE aus der Registry; AMD64, ARM64 und IA64 sind 64 Bit, x86 ist 32 Bit."
      },
      "otNote": {
        "en": "Old panel PCs and drivers for legacy interface cards exist only for 32-bit Windows; replacement is then a migration project.",
        "de": "Alte Panel-PCs und Treiber für ältere Schnittstellenkarten gibt es nur für 32-Bit-Windows; der Wechsel ist dann ein Migrationsprojekt."
      },
      "remedy": {
        "en": "Reinstall the machine with a 64-bit edition when the hardware and the plant software allow it.",
        "de": "Den Rechner mit einer 64-Bit-Ausgabe neu installieren, sobald Hardware und Anlagensoftware das zulassen."
      },
      "suggestedReason": "technicalNecessity",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "registry",
        "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment",
        "value": "PROCESSOR_ARCHITECTURE",
        "valueType": "sz",
        "op": "in",
        "expected": [
          "AMD64",
          "ARM64",
          "IA64"
        ],
        "whenMissing": "notCheckable"
      },
      "remediation": {
        "manual": {
          "en": "Reinstall with a 64-bit edition of Windows.",
          "de": "Mit einer 64-Bit-Ausgabe von Windows neu installieren."
        }
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "Operating system architecture",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
        },
