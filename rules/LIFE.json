    {
      "id": "LIFE-03",
      "since": "2026.10",
      "state": "active",
      "category": "lifecycle",
      "severity": "medium",
      "kind": "check",
      "title": {
        "en": "Automatic Updates are not switched off",
        "de": "Automatische Updates sind nicht abgeschaltet"
      },
      "rationale": {
        "en": "With Automatic Updates switched off by policy, or the Windows Update service disabled, a machine stays on its patch level until someone intervenes. The rule fails when the policy value NoAutoUpdate is 1 or the service wuauserv is disabled. Updates from WSUS or a maintenance process are fine as long as the client is not switched off.",
        "de": "Sind automatische Updates per Richtlinie abgeschaltet oder ist der Windows-Update-Dienst deaktiviert, bleibt ein Rechner auf seinem Patchstand, bis jemand eingreift. Die Regel schlägt fehl, wenn der Richtlinienwert NoAutoUpdate 1 ist oder der Dienst wuauserv deaktiviert ist. Updates über WSUS oder einen Wartungsprozess sind in Ordnung, solange der Client nicht abgeschaltet ist."
      },
      "otNote": {
        "en": "On validated plant systems automatic updates are often off by design; updates come through WSUS or offline packages in maintenance windows. Record this in the role's tailoring (see the HMI template) or as an exception.",
        "de": "Auf validierten Anlagensystemen sind automatische Updates oft bewusst aus; Updates kommen über WSUS oder Offline-Pakete im Wartungsfenster. Das im Zuschnitt der Rolle (siehe Vorlage HMI) oder als Ausnahme festhalten."
      },
      "remedy": {
        "en": "Set \"Configure Automatic Updates\" to Enabled (or Not configured) and keep the Windows Update service on Manual.",
        "de": "„Automatische Updates konfigurieren“ auf Aktiviert (oder Nicht konfiguriert) setzen und den Dienst Windows Update auf Manuell lassen."
      },
      "suggestedReason": "vendorRequirement",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "allOf",
        "checks": [
          {
            "type": "registry",
            "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
            "value": "NoAutoUpdate",
            "valueType": "dword",
            "op": "ne",
            "expected": 1,
            "whenMissing": "osDefault",
            "osDefaults": [
              {
                "minBuild": 10240,
                "value": 0,
                "source": "https://learn.microsoft.com/en-us/windows/deployment/update/waas-wu-settings",
                "seen": "2026-10-18"
              }
            ]
          },
          {
            "type": "service",
            "name": "wuauserv",
            "startMode": [
              "Manual",
              "Auto"
            ],
            "ifAbsent": "fail"
          }
        ]
      },
      "remediation": {
        "registry": [
          {
            "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
            "value": "NoAutoUpdate",
            "type": "dword",
            "data": 0
          }
        ],
        "manual": {
          "en": "Set the Windows Update service (wuauserv) to Manual start.",
          "de": "Dienst Windows Update (wuauserv) auf Starttyp Manuell setzen."
        }
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "Operating system patching",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
        },
        {
          "src": "GSPP",
          "ids": [
            "KONF.8.1",
            "KONF.8.1.1"
          ],
          "version": "2026-09-24"
        },
        {
          "src": "ATTACK",
          "ids": [
            "M1051",
            "M0951"
          ],
          "url": "https://attack.mitre.org/mitigations/enterprise/",
          "version": "v20.0"
        }
      ],
      "textSources": [],
      "verified": [
        {
          "src": "ACSC",
