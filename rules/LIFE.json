    {
      "id": "LIFE-04",
      "since": "2026.10",
      "state": "active",
      "category": "lifecycle",
      "severity": "medium",
      "kind": "check",
      "title": {
        "en": "Microsoft Defender security intelligence is current",
        "de": "Virensignaturen von Microsoft Defender sind aktuell"
      },
      "rationale": {
        "en": "Signature-based detection only finds what the installed security intelligence knows. Riegel reads when Microsoft Defender last updated its signatures and expects an age of at most one day at the time of collection. The rule applies only where Defender is the active antivirus; with another active product it is not applicable, without any active antivirus it fails.",
        "de": "Signaturbasierte Erkennung findet nur, was die installierten Signaturen kennen. Riegel liest, wann Microsoft Defender seine Signaturen zuletzt aktualisiert hat, und erwartet zum Zeitpunkt der Erfassung ein Alter von höchstens einem Tag. Die Regel gilt nur, wenn Defender der aktive Virenschutz ist; mit einem anderen aktiven Produkt ist sie nicht anwendbar, ohne aktiven Virenschutz schlägt sie fehl."
      },
      "otNote": {
        "en": "Offline plants update signatures with offline packages on a fixed schedule. If the schedule is longer than a day, record it as an exception with the schedule as compensating measure.",
        "de": "Offline-Anlagen aktualisieren Signaturen mit Offline-Paketen nach festem Plan. Ist der Abstand länger als ein Tag, als Ausnahme mit dem Plan als ausgleichender Maßnahme festhalten."
      },
      "remedy": {
        "en": "Make sure security intelligence updates arrive at least daily (Windows Update, WSUS, a file share or the offline update package).",
        "de": "Sicherstellen, dass Signaturupdates mindestens täglich ankommen (Windows Update, WSUS, Dateifreigabe oder Offline-Paket)."
      },
      "suggestedReason": "compensatingControl",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "defenderSetting",
        "source": "status",
        "property": "AntivirusSignatureLastUpdated",
        "op": "ageDaysLe",
        "expected": 1
      },
      "remediation": {
        "manual": {
          "en": "Schedule daily security intelligence updates.",
          "de": "Tägliche Signaturupdates einrichten."
        }
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "Antivirus software",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
