    {
      "id": "LIFE-02",
      "since": "2026.10",
      "state": "active",
      "category": "lifecycle",
      "severity": "high",
      "kind": "check",
      "title": {
        "en": "Latest cumulative update is recent",
        "de": "Letztes kumulatives Update ist aktuell"
      },
      "rationale": {
        "en": "Every month Microsoft fixes vulnerabilities that attackers analyse within days. Riegel takes the release date of the installed build and revision (UBR) from Microsoft's release tables; without a table entry it uses the newest installed hotfix or the newest successful Windows Update history entry. The age is measured against the time of collection and compared with the plant setting updateMaxDays (default 35 days).",
        "de": "Microsoft behebt jeden Monat Schwachstellen, die Angreifer innerhalb weniger Tage auswerten. Riegel nimmt das Veröffentlichungsdatum von Build und Revision (UBR) aus den Microsoft-Release-Tabellen; ohne Tabelleneintrag zählt der neueste installierte Hotfix oder der neueste erfolgreiche Eintrag im Windows-Update-Verlauf. Das Alter wird zum Zeitpunkt der Erfassung gemessen und mit der Anlageneinstellung updateMaxDays (Standard 35 Tage) verglichen."
      },
      "otNote": {
        "en": "Validated systems are patched only in maintenance windows after vendor approval. Plan the next update as a measure with a due date instead of excepting the rule permanently.",
        "de": "Validierte Systeme werden nur im Wartungsfenster nach Herstellerfreigabe gepatcht. Das nächste Update als Maßnahme mit Termin planen, statt die Regel dauerhaft auszunehmen."
      },
      "remedy": {
        "en": "Install the latest cumulative update for this build (Windows Update, WSUS or the offline package from the Microsoft Update Catalog) after the vendor has released it.",
        "de": "Das neueste kumulative Update für diesen Build installieren (Windows Update, WSUS oder Offline-Paket aus dem Microsoft Update-Katalog), nachdem der Hersteller es freigegeben hat."
      },
      "suggestedReason": "vendorRequirement",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "updateAge"
      },
      "remediation": {
        "manual": {
          "en": "Install the latest cumulative update.",
          "de": "Neuestes kumulatives Update installieren."
        }
      },
      "references": [
        {
