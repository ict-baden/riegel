{
  "schema": "riegel.rules/1",
  "prefix": "UAC",
  "rules": [
    {
      "id": "UAC-01",
      "since": "2026.10",
      "state": "active",
      "category": "accounts",
      "severity": "high",
      "kind": "check",
      "title": {
        "en": "User Account Control is on",
        "de": "Benutzerkontensteuerung ist eingeschaltet"
      },
      "rationale": {
        "en": "With EnableLUA = 0 every administrator process runs with full rights without any prompt, and protected mode features that rely on UAC are off. The value must be 1, the Windows default.",
        "de": "Mit EnableLUA = 0 läuft jeder Administratorprozess ohne Rückfrage mit vollen Rechten, und auf UAC aufbauende Schutzfunktionen sind aus. Der Wert muss 1 sein, der Windows-Standard."
      },
      "otNote": {
        "en": "Some old plant software fails when UAC filters administrator rights. Fix the installation (run elevated once, correct file permissions) instead of turning UAC down.",
        "de": "Manche alte Anlagensoftware scheitert, wenn UAC Administratorrechte filtert. Besser die Installation korrigieren (einmal erhöht ausführen, Dateirechte richten), statt UAC abzuschwächen."
      },
      "remedy": {
        "en": "Set \"User Account Control: Run all administrators in Admin Approval Mode\" to Enabled and restart.",
        "de": "„Benutzerkontensteuerung: Alle Administratoren im Administratorbestätigungsmodus ausführen“ aktivieren und neu starten."
      },
      "suggestedReason": "vendorRequirement",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "EnableLUA",
        "valueType": "dword",
        "op": "eq",
        "expected": 1,
        "whenMissing": "osDefault",
        "osDefaults": [
          {
            "minBuild": 10240,
            "value": 1,
            "source": "https://learn.microsoft.com/en-us/windows/security/application-security/application-control/user-account-control/settings-and-configuration",
            "seen": "2026-10-18"
          }
        ]
      },
      "remediation": {
        "registry": [
          {
            "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "value": "EnableLUA",
            "type": "dword",
            "data": 1
          }
        ]
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "Elevating privileges",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
        },
        {
