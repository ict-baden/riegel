    {
      "id": "UAC-02",
      "since": "2026.10",
      "state": "active",
      "category": "accounts",
      "severity": "medium",
      "kind": "check",
      "title": {
        "en": "Administrators are prompted on the secure desktop",
        "de": "Administratoren werden auf dem sicheren Desktop gefragt"
      },
      "rationale": {
        "en": "The elevation prompt for administrators must appear on the secure desktop, where other programs cannot click it or read what is typed: \"Prompt for credentials on the secure desktop\" (1, ACSC) or \"Prompt for consent on the secure desktop\" (2, DISA). The Windows default (5) elevates Windows binaries silently and fails.",
        "de": "Die Rückfrage zur Rechteerhöhung für Administratoren muss auf dem sicheren Desktop erscheinen, wo andere Programme sie weder anklicken noch Eingaben mitlesen können: „Aufforderung zu Anmeldeinformationen auf dem sicheren Desktop“ (1, ACSC) oder „Aufforderung zur Zustimmung auf dem sicheren Desktop“ (2, DISA). Der Windows-Standard (5) erhöht Windows-Programme ohne Rückfrage und schlägt fehl."
      },
      "remedy": {
        "en": "Set \"User Account Control: Behavior of the elevation prompt for administrators in Admin Approval Mode\" to \"Prompt for credentials on the secure desktop\".",
        "de": "„Benutzerkontensteuerung: Verhalten der Benutzeraufforderung mit erhöhten Rechten für Administratoren im Administratorbestätigungsmodus“ auf „Aufforderung zu Anmeldeinformationen auf dem sicheren Desktop“ setzen."
      },
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "ConsentPromptBehaviorAdmin",
        "valueType": "dword",
        "op": "in",
        "expected": [
          1,
          2
        ],
        "whenMissing": "osDefault",
        "osDefaults": [
          {
            "minBuild": 10240,
            "value": 5,
            "source": "https://learn.microsoft.com/en-us/windows/security/application-security/application-control/user-account-control/settings-and-configuration",
            "seen": "2026-10-18"
          }
        ]
      },
      "remediation": {
        "registry": [
          {
            "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "value": "ConsentPromptBehaviorAdmin",
            "type": "dword",
            "data": 1
          }
        ]
      },
      "references": [
        {
          "src": "ACSC",
          "doc": "Hardening Microsoft Windows 11 workstations (last reviewed 2026-01-23)",
          "section": "Elevating privileges",
          "url": "https://www.cyber.gov.au/publication/hardening-microsoft-windows-11-workstations"
