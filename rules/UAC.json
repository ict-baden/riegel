    {
      "id": "UAC-04",
      "since": "2026.10",
      "state": "active",
      "category": "accounts",
      "severity": "medium",
      "kind": "check",
      "title": {
        "en": "Admin Approval Mode applies to the built-in Administrator",
        "de": "Administratorbestätigungsmodus gilt für den integrierten Administrator"
      },
      "rationale": {
        "en": "Without Admin Approval Mode the built-in Administrator runs every program with full rights and no prompt. FilterAdministratorToken must be 1; the Windows default (0) fails.",
        "de": "Ohne Administratorbestätigungsmodus führt der integrierte Administrator jedes Programm ohne Rückfrage mit vollen Rechten aus. FilterAdministratorToken muss 1 sein; der Windows-Standard (0) schlägt fehl."
      },
      "otNote": {
        "en": "Some old plant software fails when UAC filters administrator rights. Fix the installation (run elevated once, correct file permissions) instead of turning UAC down.",
        "de": "Manche alte Anlagensoftware scheitert, wenn UAC Administratorrechte filtert. Besser die Installation korrigieren (einmal erhöht ausführen, Dateirechte richten), statt UAC abzuschwächen."
      },
      "remedy": {
        "en": "Set \"User Account Control: Admin Approval Mode for the Built-in Administrator account\" to Enabled.",
        "de": "„Benutzerkontensteuerung: Administratorbestätigungsmodus für das integrierte Administratorkonto“ aktivieren."
      },
      "suggestedReason": "vendorRequirement",
      "appliesTo": {
        "os": [
          "client",
          "server"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "registry",
        "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
        "value": "FilterAdministratorToken",
        "valueType": "dword",
        "op": "eq",
        "expected": 1,
        "whenMissing": "osDefault",
        "osDefaults": [
          {
            "minBuild": 10240,
            "value": 0,
            "source": "https://learn.microsoft.com/en-us/windows/security/application-security/application-control/user-account-control/settings-and-configuration",
            "seen": "2026-10-18"
          }
        ]
      },
      "remediation": {
        "registry": [
          {
            "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
            "value": "FilterAdministratorToken",
            "type": "dword",
            "data": 1
          }
        ]
      },
