<Project>
  <!-- Gemeinsame Einstellungen für alle Projekte im Repo (nach der Vorlage der internen Richtlinien) -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Firmierung wie im Impressum (https://ict-baden.de/impressum/). Der Sammler behält die bisherigen Werte (seine csproj). -->
    <Company>ICT Baden GmbH</Company>
    <Product>Riegel</Product>
    <Copyright>© 2026 ICT Baden GmbH</Copyright>
    <!-- Basisversion für alle Teile außer dem Sammler (Richtlinie 04). CI-Builds setzen -p:Version=<Basis>-ci.<Lauf>;
         der Sammler hat seine eigene Version in src/Riegel.Collector/collector-version.txt und ignoriert -p:Version
         (TreatAsLocalProperty in seiner csproj), damit seine Bytes stabil bleiben. -->
    <Version>1.0.1</Version>
    <!-- *Strings.resx ist Englisch und Rückfallsprache, siehe richtlinien/13 -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Nur unsere fünf Sprachen mitliefern (eigene und fremde Pakete) -->
    <SatelliteResourceLanguages>en;de;es;fr;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
