<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Auswerte-App (spec 3, 7.8): WPF, weil „Diesen PC prüfen“ Rechteerhöhung und die Windows-Shell braucht.
         Fensterprogramm mit Konsolen-Anbindung wie Zutritt; für Skripte gibt es Riegel.Cli.exe (spec 4.2). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- net10.0-windows ohne Windows-SDK-Version: Riegel nutzt keine WinRT-API, so kommt Microsoft.Windows.SDK.NET.dll (Lizenz des Windows SDK, nicht MIT) nicht in die Pakete. Mindestens Windows 10 1809 / Server 2019 bleibt Vorgabe (docs/installation.md); SupportedOSPlatformVersion 10.0.17763 ginge nur mit SDK-Version (NETSDK1135). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <RootNamespace>Riegel</RootNamespace>
    <AssemblyName>Riegel</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\riegel.ico</ApplicationIcon>
    <Description>Checks Windows machines in plants, labs and control rooms against a hardening baseline – read-only and offline – records justified exceptions and produces an evidence report for sign-off.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Eigener Einstiegspunkt (Program.Main): Befehlszeile ganz ohne WPF, sonst Oberfläche.
         App.xaml wird deshalb als normale Seite übersetzt, nicht als ApplicationDefinition mit eigenem Main. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF lässt System.IO aus den impliziten usings weg (Path kollidiert mit System.Windows.Shapes.Path) -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Riegel.Core\Riegel.Core.csproj" />
    <ProjectReference Include="..\Riegel.Commands\Riegel.Commands.csproj" />
    <ProjectReference Include="..\Riegel.Platform.Windows\Riegel.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\riegel.ico" />
    <Resource Include="Assets\riegel.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\UiStrings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Riegel.Resources"
                      StronglyTypedClassName="UiStrings" StronglyTypedFileName="$(IntermediateOutputPath)UiStrings.g.cs" PublicClass="true" />
  </ItemGroup>

  <!-- Demo-Anlage „Musterwerk – Linie 3“ (spec 7.9): synthetische Exporte, eingebettet als "demo/<Pfad>" -->
  <ItemGroup>
    <EmbeddedResource Include="Demo\**\*.json" LogicalName="demo/%(RecursiveDir)%(Filename)%(Extension)" RiegelLogicalName="true" WithCulture="false" />
  </ItemGroup>

  <Target Name="RiegelNormalizeLogicalNames" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Condition="'%(EmbeddedResource.RiegelLogicalName)' == 'true'">
        <LogicalName>$([System.String]::Copy('%(EmbeddedResource.LogicalName)').Replace('\', '/'))</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- Lizenztexte neben die Exe (ZIP, MSI); eingebettet sind sie in Riegel.Core (Info-Seite der einzelnen Exe) -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\notices\THIRD-PARTY-NOTICES-dotnet-*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Entwicklung: das Sammler-Paket als collector\ neben Riegel.exe im Build-Ordner (für O15 und den Demo-Bericht). Nie
       im Publish (sonst steckte die Exe in der Einzeldatei, spec 14); MSI und ZIP bekommen collector\ aus der CI. -->
  <ItemGroup>
    <ProjectReference Include="..\Riegel.Collector\Riegel.Collector.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net35" Private="false" />
    <None Include="..\Riegel.Collector\bin\$(Configuration)\net35\Riegel.Collector.exe" Link="collector\Riegel.Collector.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\Riegel.Collector\bin\$(Configuration)\net35\Riegel.Collector.exe.config" Link="collector\Riegel.Collector.exe.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\tools\collect-builtin\collect-builtin.cmd" Link="collector\collect-builtin.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\Riegel.Collector\README.txt" Link="collector\README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\LICENSE" Link="collector\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="collector\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Riegel.Tests" />
  </ItemGroup>
</Project>
