<Window x:Class="Riegel.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Riegel.UI"
        xmlns:vm="clr-namespace:Riegel.ViewModels"
        xmlns:pages="clr-namespace:Riegel.UI.Pages"
        Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}" UseLayoutRounding="True" AllowDrop="True"
        Icon="pack://application:,,,/Riegel;component/Assets/riegel.ico">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:StartViewModel}"><pages:StartPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MachinesViewModel}"><pages:MachinesPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><pages:ResultsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExceptionsViewModel}"><pages:ExceptionsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TailoringViewModel}"><pages:TailoringPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MeasuresViewModel}"><pages:MeasuresPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ComparisonViewModel}"><pages:ComparisonPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><pages:ReportsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CatalogueViewModel}"><pages:CataloguePage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}"><pages:AboutPage/></DataTemplate>

    <DataTemplate x:Key="NavTemplate">
      <RadioButton Style="{StaticResource NavItem}" Tag="{Binding Glyph}" Content="{Binding Title}" GroupName="nav"
                   IsChecked="{Binding IsSelected, Mode=TwoWay}"
                   Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                   ui:Nav.Badge="{Binding Badge}" ui:Nav.BadgeTone="{Binding BadgeTone}"
                   AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Subtitle}"/>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="268"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===================== Navigation ===================== -->
    <DockPanel Margin="12,12,8,12" IsEnabled="{Binding IsIdle}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6,0,18">
        <Image Source="pack://application:,,,/Riegel;component/Assets/riegel.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Riegel" Style="{StaticResource BodyStrong}" FontSize="16"/>
          <TextBlock Text="{ui:T App_Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="190"/>
        </StackPanel>
      </StackPanel>

      <!-- Geöffnete Anlage -->
      <Border DockPanel.Dock="Top" Margin="4,0,4,12" CornerRadius="8" Padding="12,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BrandBrush}">
            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center" Foreground="White"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding PlantTitle}" Style="{StaticResource BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="{Binding PlantTitle}"/>
            <TextBlock Text="{Binding PlantDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding FooterPages}" ItemTemplate="{StaticResource NavTemplate}" Focusable="False"
                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Local"/>
      <ItemsControl ItemsSource="{Binding Pages}" ItemTemplate="{StaticResource NavTemplate}" Focusable="False"
                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Local"
                    AutomationProperties.Name="{ui:T Main_Navigation}"/>
    </DockPanel>

    <!-- ===================== Inhalt ===================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Margin="32,22,32,10">
        <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Text="{Binding SelectedPage.Subtitle}" Style="{StaticResource Caption}" FontSize="13" Margin="1,2,0,0"/>
      </StackPanel>

      <!-- Prüfermodus / Demo: über allen Seiten -->
      <Border Grid.Row="1" Margin="32,0,32,8" Style="{StaticResource InfoBox}" Visibility="{Binding HasModeBanner, Converter={StaticResource BoolToVisible}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource Caution}"/>
          <TextBlock Text="{Binding ModeBanner}" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding SelectedPage}" Focusable="False" IsTabStop="False" IsEnabled="{Binding IsIdle}"/>

      <!-- Seite braucht eine Anlage -->
      <Border Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}" Visibility="{Binding SelectedPage.ShowNoPlant, Converter={StaticResource BoolToVisible}}"
              IsEnabled="{Binding IsIdle}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="32">
          <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="{ui:T Main_NoPlantTitle}" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock Text="{ui:T Main_NoPlantText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,14"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{DynamicResource AccentButton}" Command="{Binding Start.OpenCommand}" Content="{ui:T Start_Open}" Margin="0,0,8,0"/>
            <Button Command="{Binding Start.DemoCommand}" Content="{ui:T Start_Demo}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Meldungen (Fußleiste wie Zutritt) -->
      <Border Grid.Row="3" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0" Padding="32,10,24,10">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding NoticeTone}" Value="Critical"><Setter Property="Background" Value="{DynamicResource CriticalBg}"/></DataTrigger>
              <DataTrigger Binding="{Binding NoticeTone}" Value="Caution"><Setter Property="Background" Value="{DynamicResource CautionBg}"/></DataTrigger>
              <DataTrigger Binding="{Binding NoticeTone}" Value="Good"><Setter Property="Background" Value="{DynamicResource GoodBg}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding NoticeGlyph}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top" Padding="0,2,0,0"/>
          <TextBlock Grid.Column="1" Text="{Binding Notice}" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
          <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Command="{Binding CloseNoticeCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                  ToolTip="{ui:T Main_CloseNotice}" AutomationProperties.Name="{ui:T Main_CloseNotice}">
            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
          </Button>
        </Grid>
      </Border>

      <!-- Läuft gerade … -->
      <Border Grid.RowSpan="4" Background="#40000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
        <Border x:Name="BusyCard" Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,18" MinWidth="320"
                Focusable="True" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding BusyText}">
          <StackPanel>
            <TextBlock Text="{Binding BusyText}" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" TextAlignment="Center"
                       AutomationProperties.LiveSetting="Assertive"/>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Grid>
</Window>
