<UserControl x:Class="Riegel.UI.Pages.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Riegel.UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,26,24" Focusable="False">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

      <!-- ========== Anlage geöffnet: Zählungen zuerst, dann Werte (spec 2.6) ========== -->
      <Border Style="{StaticResource HeroCard}" Visibility="{Binding Session.HasPlant, Converter={StaticResource BoolToVisible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <WrapPanel>
              <TextBlock Text="{Binding PlantName}" Style="{StaticResource SubtitleText}" Margin="0,0,10,0"/>
              <ui:TonePill Text="{Binding PlantMode}" Tone="Caution" Visibility="{Binding HasPlantMode, Converter={StaticResource BoolToVisible}}"/>
            </WrapPanel>
            <TextBlock Text="{Binding PlantFolder}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <TextBlock Text="{Binding MachinesText}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding OpenCountsText}" Style="{StaticResource BodyStrong}" Margin="0,12,0,0"/>
            <WrapPanel Margin="0,10,0,0">
              <ui:StatTile Value="{Binding OpenHigh}" Label="{ui:T Start_TileHigh}" Tone="High" MinWidth="128"/>
              <ui:StatTile Value="{Binding OpenMedium}" Label="{ui:T Start_TileMedium}" Tone="Medium" MinWidth="128"/>
              <ui:StatTile Value="{Binding OpenLow}" Label="{ui:T Start_TileLow}" Tone="Low" MinWidth="128"/>
              <ui:StatTile Value="{Binding Regressions}" Label="{ui:T Start_TileRegressions}" Glyph="&#xE74B;" Tone="Caution" MinWidth="128"/>
              <ui:StatTile Value="{Binding Expiring}" Label="{ui:T Start_TileExpiring}" Glyph="&#xE823;" MinWidth="128"/>
              <ui:StatTile Value="{Binding Pending}" Label="{ui:T Start_TilePending}" Glyph="&#xE7BA;" MinWidth="128"/>
              <ui:StatTile Value="{Binding Overdue}" Label="{ui:T Start_TileOverdue}" Glyph="&#xE916;" Tone="Caution" MinWidth="128"/>
            </WrapPanel>
          </StackPanel>
          <!-- Werte: Härtungsgrad, Dokumentiert, Prüfumfang -->
          <StackPanel Grid.Column="1" Margin="20,0,0,0" MinWidth="230">
            <TextBlock Text="{ui:T Start_Score}" Style="{StaticResource Caption}"/>
            <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Incomplete}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Grid Height="6" Width="220" HorizontalAlignment="Left" Margin="0,2,0,8">
              <Border CornerRadius="3" Background="{DynamicResource ScoreTrack}"/>
              <Border CornerRadius="3" HorizontalAlignment="Left" Background="{DynamicResource BrandBrush}"
                      Width="{Binding ScoreValue, Converter={StaticResource PercentWidth}, ConverterParameter=220}"/>
            </Grid>
            <TextBlock Style="{StaticResource Caption}">
              <Run Text="{ui:T Start_Documented}"/><Run Text=" "/><Run Text="{Binding DocumentedText, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Caption}">
              <Run Text="{ui:T Start_Share}"/><Run Text=" "/><Run Text="{Binding ShareText, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
            <Border Style="{StaticResource InfoBox}" Margin="0,8,0,0" Padding="10,6" MaxWidth="240" HorizontalAlignment="Left"
                    Visibility="{Binding Incomplete, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{Binding IncompleteText}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Command="{Binding GoResultsCommand}" Content="{ui:T Start_ShowResults}" Margin="0,0,8,0"/>
              <Button Command="{Binding CloseCommand}" Content="{ui:T Start_ClosePlant}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========== Keine Anlage: Begrüßung ========== -->
      <Border Style="{StaticResource HeroCard}" Visibility="{Binding Session.HasPlant, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
        <StackPanel Orientation="Horizontal">
          <Image Source="pack://application:,,,/Riegel;component/Assets/riegel.png" Width="56" Height="56" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="18,0,0,0" MaxWidth="760">
            <TextBlock Text="{ui:T Start_WelcomeTitle}" Style="{StaticResource SubtitleText}"/>
            <TextBlock Text="{ui:T Start_WelcomeText}" Style="{StaticResource Body}" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ========== Aktionen ========== -->
      <TextBlock Text="{ui:T Start_Actions}" Style="{StaticResource SectionText}"/>
      <UniformGrid Columns="2">
        <!-- Anlage -->
        <Border Style="{StaticResource Card}" Margin="0,0,6,8">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
              <TextBlock Text="{ui:T Start_PlantCardTitle}" Style="{StaticResource BodyStrong}"/>
            </StackPanel>
            <TextBlock Text="{ui:T Start_PlantCardText}" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
            <WrapPanel>
              <Button Style="{DynamicResource AccentButton}" Command="{Binding OpenCommand}" Margin="0,0,8,6" ToolTip="{ui:T Start_OpenShortcut}">
                <TextBlock Text="{ui:T Start_Open}"/>
              </Button>
              <Button Command="{Binding CreateCommand}" Content="{ui:T Start_Create}" Margin="0,0,8,6"/>
            </WrapPanel>
            <CheckBox IsChecked="{Binding OpenReadOnly}" Content="{ui:T Start_ReadOnly}" Margin="0,4,0,0" ToolTip="{ui:T Start_ReadOnlyHint}"/>
          </StackPanel>
        </Border>
        <!-- Diesen PC prüfen -->
        <Border Style="{StaticResource Card}" Margin="6,0,0,8">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
              <TextBlock Text="{ui:T Start_CheckCardTitle}" Style="{StaticResource BodyStrong}"/>
            </StackPanel>
            <TextBlock Text="{Binding CheckHint}" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
            <WrapPanel>
              <Button x:Name="CheckButton" Style="{DynamicResource AccentButton}" Command="{Binding CheckCommand}" Margin="0,0,8,6" ToolTip="F5">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             Visibility="{Binding ShowLimitedCheck, Converter={StaticResource BoolToVisible}}"/>
                  <TextBlock Text="{Binding CheckLabel}"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding CheckLimitedCommand}" Content="{ui:T Start_CheckLimited}" Margin="0,0,8,6"
                      Visibility="{Binding ShowLimitedCheck, Converter={StaticResource BoolToVisible}}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <!-- Exporte importieren (Ziehen und Ablegen) -->
        <Border x:Name="DropZone" Style="{StaticResource Card}" Margin="0,0,6,8" AllowDrop="True">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
              <TextBlock Text="{ui:T Start_ImportCardTitle}" Style="{StaticResource BodyStrong}"/>
            </StackPanel>
            <TextBlock Text="{ui:T Start_ImportCardText}" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
            <WrapPanel>
              <Button Command="{Binding ImportCommand}" Content="{ui:T Start_Import}" Margin="0,0,8,6" ToolTip="{ui:T Start_ImportShortcut}"/>
            </WrapPanel>
            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{ui:T Start_DropHint}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <!-- Sammler und Demo -->
        <Border Style="{StaticResource Card}" Margin="6,0,0,8">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE88E;" Style="{StaticResource Icon}" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
              <TextBlock Text="{ui:T Start_CollectorCardTitle}" Style="{StaticResource BodyStrong}"/>
            </StackPanel>
            <TextBlock Text="{ui:T Start_CollectorCardText}" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
            <WrapPanel>
              <Button Command="{Binding CopyCollectorCommand}" Content="{ui:T Start_CopyCollector}" Margin="0,0,8,6"/>
              <Button Command="{Binding DemoCommand}" Content="{ui:T Start_Demo}" Margin="0,0,8,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ========== Zuletzt geöffnet ========== -->
      <TextBlock Text="{ui:T Start_Recent}" Style="{StaticResource SectionText}" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisible}}"/>
      <ItemsControl ItemsSource="{Binding Recent}" Focusable="False" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisible}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="14,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                  <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{ui:T Start_OpenRecent}" Margin="12,0,6,0"
                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                <Button Grid.Column="3" Style="{DynamicResource GhostButton}" ToolTip="{ui:T Start_ForgetRecent}" AutomationProperties.Name="{ui:T Start_ForgetRecent}"
                        Command="{Binding DataContext.ForgetRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                  <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
