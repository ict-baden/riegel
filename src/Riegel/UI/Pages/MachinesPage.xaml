<UserControl x:Class="Riegel.UI.Pages.MachinesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Riegel.UI">
  <Grid Margin="32,0,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>

    <!-- Werkzeugleiste -->
    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,10" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center"/>
      <Button DockPanel.Dock="Right" Command="{Binding ReEvaluateCommand}" Content="{ui:T Machines_ReEvaluate}" Margin="8,0,0,0" ToolTip="{ui:T Machines_ReEvaluateHint}"/>
      <Button DockPanel.Dock="Right" Command="{Binding GroupsCommand}" Content="{ui:T Machines_Groups}" Margin="8,0,0,0"/>
      <Button DockPanel.Dock="Right" Command="{Binding EditCommand}" Content="{ui:T Machines_Edit}" Margin="8,0,0,0"/>
    </DockPanel>

    <!-- Liste -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
      <ListView x:Name="List" Style="{DynamicResource ListTable}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                ui:ListTable.Columns="1.2*:116, 1.4*:136, 96, 70, 1*:96, 60" AutomationProperties.Name="{ui:T Page_machines}">
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Header="{ui:T Machines_ColHost}" ui:ListTable.SortBy="Host">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Host}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" FontSize="11" Margin="6,0,0,0" ToolTip="{ui:T Machines_HasIdentity}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding HasIdentity, Converter={StaticResource BoolToVisible}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource CellCaption}" Visibility="{Binding Label, Converter={StaticResource NullToCollapsed}}"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{ui:T Machines_ColGroup}" ui:ListTable.SortBy="Group">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel ToolTip="{Binding Os}">
                    <TextBlock Text="{Binding Group}" Style="{StaticResource CellText}"/>
                    <TextBlock Text="{Binding Role}" Style="{StaticResource CellCaption}"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{ui:T Machines_ColCollected}">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel ToolTip="{Binding CollectedHint}">
                    <TextBlock Text="{Binding Collected}" Style="{StaticResource CellText}"/>
                    <ui:TonePill Text="{Binding StaleText}" Tone="Caution" HorizontalAlignment="Left" Visibility="{Binding Stale, Converter={StaticResource BoolToVisible}}"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{ui:T Machines_ColOpen}">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding OpenText}" Style="{StaticResource CellText}" ToolTip="{ui:T Machines_OpenHint}"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{ui:T Machines_ColScore}" ui:ListTable.SortBy="Score">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding ScoreText}" Style="{StaticResource CellText}"/>
                    <TextBlock Text="{Binding ShareText}" Style="{StaticResource CellCaption}"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{ui:T Machines_ColTrend}">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" ToolTip="{ui:T Machines_WorseHint}">
                    <TextBlock Text="{Binding TrendGlyph}" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding TrendText}" AutomationProperties.Name="{Binding TrendText}"/>
                    <TextBlock Text="{Binding WorseText}" FontWeight="SemiBold" Foreground="{DynamicResource Critical}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <!-- Detail -->
    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16" Focusable="False">
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
          <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SubtitleText}" FontSize="17"/>
          <TextBlock Text="{Binding DetailGroup}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding DetailNotes}" Style="{StaticResource Body}" FontSize="13" Margin="0,8,0,0"
                     Visibility="{Binding DetailNotes, Converter={StaticResource NullToCollapsed}}"/>
          <WrapPanel Margin="0,12,0,0">
            <Button Command="{Binding ResultsCommand}" Content="{ui:T Machines_ShowResults}" Margin="0,0,8,6"/>
            <Button Command="{Binding CompareCommand}" Content="{ui:T Machines_ShowComparison}" Margin="0,0,8,6"/>
          </WrapPanel>

          <TextBlock Text="{ui:T Machines_Collection}" Style="{StaticResource SectionText}" Margin="0,14,0,6"/>
          <ItemsControl ItemsSource="{Binding Collection}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}" FontSize="13"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding ApprovedText}" Style="{StaticResource Body}" FontSize="13" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding EsuText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

          <TextBlock Text="{ui:T Machines_Identity}" Style="{StaticResource SectionText}" Margin="0,14,0,6"
                     Visibility="{Binding HasIdentity, Converter={StaticResource BoolToVisible}}"/>
          <ItemsControl ItemsSource="{Binding Identity}" Focusable="False" Visibility="{Binding HasIdentity, Converter={StaticResource BoolToVisible}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}" FontSize="13"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
