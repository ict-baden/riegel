<UserControl x:Class="Riegel.UI.Pages.CataloguePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Riegel.UI">
  <Grid Margin="32,0,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="400"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Header}" Style="{StaticResource BodyStrong}" FontSize="13"/>
        <TextBlock Text="{Binding CountsText}" Style="{StaticResource Caption}"/>
      </StackPanel>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,8,0" VerticalAlignment="Center"
                AutomationProperties.Name="{ui:T Filter_AllCategories}"/>
      <Grid Grid.Column="2" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="10,5,30,6" AutomationProperties.Name="{ui:T Catalogue_Search}"/>
        <TextBlock Style="{StaticResource Placeholder}" Text="{ui:T Catalogue_Search}" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,11,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
      <Grid>
        <ListView x:Name="List" Style="{DynamicResource ListTable}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  ui:ListTable.Columns="96, 2*:150, 1.1*:110, 84" AutomationProperties.Name="{ui:T Page_catalogue}">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Header="{ui:T Results_ColRule}" ui:ListTable.SortBy="Id">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource SeverityDot}"/>
                      <TextBlock Text="{Binding Id}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{ui:T Results_ColTitle}" ui:ListTable.SortBy="Title">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Title}" Style="{StaticResource CellText}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{ui:T Results_ColCategory}" ui:ListTable.SortBy="CategoryText">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding CategoryText}" Style="{StaticResource CellCaption}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{ui:T Catalogue_ColKind}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding KindText}" Style="{StaticResource CellCaption}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Margin="24" MaxWidth="420" Visibility="{Binding HasRules, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16" Focusable="False">
        <StackPanel>
          <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="{Binding DetailMeta}" Style="{StaticResource Caption}" FontSize="12.5"/>
            <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SubtitleText}" FontSize="17" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding DetailRationale}" Style="{StaticResource Body}" FontSize="13" Margin="0,8,0,0"/>
            <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0" Visibility="{Binding HasOtNote, Converter={StaticResource BoolToVisible}}">
              <StackPanel>
                <TextBlock Text="{ui:T Results_OtNote}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                <TextBlock Text="{Binding DetailOtNote}" Style="{StaticResource Body}" FontSize="13" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <StackPanel Visibility="{Binding HasRemedy, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{ui:T Results_Remedy}" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding DetailRemedy}" Style="{StaticResource DetailValue}"/>
            </StackPanel>
            <TextBlock Text="{ui:T Catalogue_AppliesTo}" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding DetailApplies}" Style="{StaticResource DetailValue}"/>
            <TextBlock Text="{Binding DetailCheck}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            <StackPanel Visibility="{Binding HasSuggested, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{ui:T Catalogue_Suggested}" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding DetailSuggested}" Style="{StaticResource DetailValue}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding HasVerified, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{ui:T Catalogue_Verified}" Style="{StaticResource Label}"/>
              <ItemsControl ItemsSource="{Binding DetailVerified}" Focusable="False">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12.5"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Visibility="{Binding HasReferences, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{ui:T Results_References}" Style="{StaticResource Label}"/>
              <ItemsControl ItemsSource="{Binding DetailReferences}" Focusable="False">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12.5"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <!-- Quellen und Lizenzen (spec 2.2) -->
          <TextBlock Text="{ui:T Catalogue_Sources}" Style="{StaticResource SectionText}"/>
          <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Style="{StaticResource Body}" FontSize="12.5">
                    <Run Text="{Binding Src, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Licence, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding Attribution}" Style="{StaticResource Caption}"/>
                  <Button Style="{StaticResource LinkButton}" Content="{Binding Url}" FontSize="12" HorizontalAlignment="Left"
                          Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Importierte Kunden-Baselines (spec 2.15) -->
    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,10,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Command="{Binding ImportBaselineCommand}" Content="{ui:T Catalogue_ImportBaselineButton}" Margin="8,0,0,0"/>
          <Button Command="{Binding ImportBaselineFolderCommand}" Content="{ui:T Catalogue_ImportGpoButton}" Margin="8,0,0,0"/>
          <Button Command="{Binding RemoveBaselineCommand}" Content="{ui:T Catalogue_RemoveBaseline}" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{ui:T Catalogue_Baselines}" Style="{StaticResource BodyStrong}" FontSize="13"/>
          <TextBlock Text="{ui:T Catalogue_BaselinesText}" Style="{StaticResource Caption}" Margin="0,2,0,6"/>
          <ListBox ItemsSource="{Binding Baselines}" SelectedItem="{Binding SelectedBaseline}" MaxHeight="120" BorderThickness="0" Background="Transparent"
                   Visibility="{Binding HasBaselines, Converter={StaticResource BoolToVisible}}" AutomationProperties.Name="{ui:T Catalogue_Baselines}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Body}" FontSize="13">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Rules, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Source, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Imported, Mode=OneWay}"/>
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{ui:T Catalogue_NoBaselines}" Style="{StaticResource Caption}" Visibility="{Binding HasBaselines, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
