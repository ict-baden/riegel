<UserControl x:Class="Riegel.UI.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Riegel.UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,26,24" Focusable="False">
    <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">

      <!-- Ausgabeordner -->
      <ui:SettingCard Glyph="&#xE8B7;" Header="{ui:T Reports_Output}" Description="{Binding OutputHint}" Tag="Below">
        <Grid MinWidth="560">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ui:T Reports_Output}"/>
          <Button Grid.Column="1" Command="{Binding BrowseCommand}" Content="{ui:T Common_Browse}" Margin="8,0,0,0"/>
          <Button Grid.Column="2" Command="{Binding OpenFolderCommand}" Content="{ui:T Reports_OpenFolder}" Margin="8,0,0,0"/>
        </Grid>
      </ui:SettingCard>

      <!-- Zuletzt geschrieben -->
      <Border Style="{StaticResource Card}" Background="{DynamicResource GoodBg}" Visibility="{Binding HasWritten, Converter={StaticResource BoolToVisible}}">
        <StackPanel>
          <TextBlock Text="{ui:T Reports_Written}" Style="{StaticResource BodyStrong}" FontSize="13"/>
          <ItemsControl ItemsSource="{Binding Written}" Focusable="False" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="12"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ========== Anlagenbericht zum Abzeichnen (O4/O5, O7, O3, O2) ========== -->
      <TextBlock Text="{ui:T Reports_PlantReport}" Style="{StaticResource SectionText}"/>
      <Border Style="{StaticResource Card}" Padding="18,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{ui:T Reports_PlantReportText}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <TextBlock Text="{ui:T Reports_Preset}" Style="{StaticResource Label}" Margin="0,0,0,3"/>
            <WrapPanel>
              <RadioButton GroupName="preset" Content="{ui:T Reports_PresetAudit}" IsChecked="{Binding Audit}" Margin="0,0,16,4"/>
              <RadioButton GroupName="preset" Content="{ui:T Reports_PresetAsDelivered}" IsChecked="{Binding AsDelivered}" Margin="0,0,16,4"/>
            </WrapPanel>
            <TextBlock Text="{ui:T Reports_Machines}" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding HostChoices}" SelectedItem="{Binding Host}" AutomationProperties.Name="{ui:T Reports_Machines}"/>
            <TextBlock Text="{ui:T Reports_Formats}" Style="{StaticResource Label}"/>
            <WrapPanel>
              <CheckBox Content="PDF" IsChecked="{Binding Pdf}" Margin="0,0,14,4"/>
              <CheckBox Content="Excel" IsChecked="{Binding Xlsx}" Margin="0,0,14,4"/>
              <CheckBox Content="CSV" IsChecked="{Binding Csv}" Margin="0,0,14,4"/>
              <CheckBox Content="JSON" IsChecked="{Binding Json}" Margin="0,0,14,4"/>
            </WrapPanel>
            <CheckBox Content="{ui:T Reports_PerMachine}" IsChecked="{Binding PerMachine}" Margin="0,6,0,4"/>
            <CheckBox Content="{ui:T Reports_Appendix}" IsChecked="{Binding Appendix}" Margin="0,0,0,4"/>
            <CheckBox Content="{ui:T Reports_WithEvidence}" IsChecked="{Binding Evidence}" Margin="0,0,0,4"/>
            <TextBlock Text="{ui:T Reports_Language}" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" AutomationProperties.Name="{ui:T Reports_Language}"/>
            <TextBlock Text="{ui:T Reports_PreTranslated}" Style="{StaticResource Caption}" Foreground="{DynamicResource Caution}" Margin="0,4,0,0"
                       Visibility="{Binding PreTranslated, Converter={StaticResource BoolToVisible}}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{ui:T Reports_SignOff}" Style="{StaticResource Label}" Margin="0,0,0,3"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{ui:T Reports_SignCreated}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,6"/>
              <TextBox Grid.Column="1" Text="{Binding CreatedRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" AutomationProperties.Name="{ui:T Reports_SignCreated}"/>
              <TextBlock Grid.Row="1" Text="{ui:T Reports_SignReviewed}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,6"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReviewedRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" AutomationProperties.Name="{ui:T Reports_SignReviewed}"/>
              <TextBlock Grid.Row="2" Text="{ui:T Reports_SignApproved}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ApprovedRole, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ui:T Reports_SignApproved}"/>
            </Grid>
            <TextBlock Text="{ui:T Reports_Confidentiality}" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding Confidentiality, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ui:T Reports_Confidentiality}"/>
            <TextBlock Text="{ui:T Reports_PerformedBy}" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding PerformedBy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ui:T Reports_PerformedBy}"/>
            <TextBlock Text="{ui:T Reports_Logo}" Style="{StaticResource Label}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Command="{Binding PickLogoCommand}" Content="{ui:T Reports_PickLogoButton}" Margin="8,0,0,0"/>
              <TextBlock Text="{Binding LogoText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
            <CheckBox Content="{ui:T Reports_SaveToPlant}" IsChecked="{Binding SaveToPlant}" IsEnabled="{Binding CanSaveToPlant}" Margin="0,10,0,0"/>
            <Button x:Name="PlantReportButton" Style="{DynamicResource AccentButton}" Command="{Binding PlantReportCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"
                    ToolTip="{ui:T Reports_Shortcut}">
              <TextBlock Text="{ui:T Reports_CreatePlantReport}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========== Weitere Dokumente ========== -->
      <TextBlock Text="{ui:T Reports_Other}" Style="{StaticResource SectionText}"/>
      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}" Margin="0,0,6,8">
          <StackPanel>
            <TextBlock Text="{ui:T Reports_Summary}" Style="{StaticResource BodyStrong}"/>
            <TextBlock Text="{ui:T Reports_SummaryText}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
            <ItemsControl ItemsSource="{Binding Plants}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanToggle}" Margin="0,0,0,4"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Command="{Binding SummaryCommand}" Content="{ui:T Reports_Create}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0,0,8">
          <StackPanel>
            <TextBlock Text="{ui:T Reports_TargetConfig}" Style="{StaticResource BodyStrong}"/>
            <TextBlock Text="{ui:T Reports_TargetConfigText}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" AutomationProperties.Name="{ui:T Reports_TargetConfig}"/>
            <Button Command="{Binding TargetConfigCommand}" Content="{ui:T Reports_Create}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,6,8">
          <StackPanel>
            <TextBlock Text="{ui:T Reports_ApprovalSheet}" Style="{StaticResource BodyStrong}"/>
            <TextBlock Text="{ui:T Reports_ApprovalSheetText}" Style="{StaticResource Caption}" Margin="0,2,0,4"/>
            <TextBlock Text="{Binding PendingText}" Style="{StaticResource Body}" FontSize="13" Margin="0,0,0,4"/>
            <Button Command="{Binding ApprovalSheetCommand}" Content="{ui:T Reports_Create}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0,0,8">
          <StackPanel>
            <TextBlock Text="{ui:T Reports_CollectionRecord}" Style="{StaticResource BodyStrong}"/>
            <TextBlock Text="{ui:T Reports_CollectionRecordText}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
            <ComboBox ItemsSource="{Binding Imports}" SelectedItem="{Binding Import}" AutomationProperties.Name="{ui:T Reports_CollectionRecord}"/>
            <Button Command="{Binding CollectionRecordCommand}" Content="{ui:T Reports_Create}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,6,8">
          <StackPanel>
            <TextBlock Text="{ui:T Reports_Evidence}" Style="{StaticResource BodyStrong}"/>
            <TextBlock Text="{ui:T Reports_EvidenceText}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
            <CheckBox Content="{ui:T Reports_BaselineContent}" IsChecked="{Binding BaselineContent}" ToolTip="{ui:T Reports_BaselineContentHint}"/>
            <Button Command="{Binding EvidenceCommand}" Content="{ui:T Reports_Create}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0,0,8">
          <StackPanel>
            <TextBlock Text="{ui:T Reports_Remediation}" Style="{StaticResource BodyStrong}"/>
            <TextBlock Text="{ui:T Reports_RemediationText}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
            <ComboBox ItemsSource="{Binding HostChoices}" SelectedItem="{Binding RemediationHost}" AutomationProperties.Name="{ui:T Reports_Remediation}"/>
            <Button Command="{Binding RemediationCommand}" Content="{ui:T Reports_Create}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,6,8">
          <StackPanel>
            <TextBlock Text="{ui:T Reports_Handover}" Style="{StaticResource BodyStrong}"/>
            <TextBlock Text="{ui:T Reports_HandoverText}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
            <Button Command="{Binding HandoverCommand}" Content="{ui:T Start_CopyCollector}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
