<UserControl x:Class="Riegel.UI.Pages.TailoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Riegel.UI">
  <Grid Margin="32,0,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="380"/>
    </Grid.ColumnDefinitions>

    <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
      <Button Command="{Binding NewCommand}" Content="{ui:T Register_New}" Margin="0,0,8,6"/>
      <Button Command="{Binding EditCommand}" Content="{ui:T Register_Edit}" Margin="0,0,8,6"/>
      <Button Command="{Binding RenewCommand}" Content="{ui:T Register_Renew}" Margin="0,0,8,6"/>
      <Button Command="{Binding RetireCommand}" Content="{ui:T Register_Retire}" Margin="0,0,8,6"/>
      <Button Command="{Binding TemplateCommand}" Content="{ui:T Register_ImportTemplate}" Margin="0,0,20,6"/>
      <Button Command="{Binding SheetCommand}" Content="{ui:T Register_Sheet}" Margin="0,0,8,6" ToolTip="{ui:T Register_SheetHint}"/>
      <Button Style="{DynamicResource AccentButton}" Command="{Binding ApproveCommand}" Margin="0,0,8,6" ToolTip="{ui:T Register_ApproveHint}">
        <TextBlock Text="{ui:T Register_Approve}"/>
      </Button>
    </WrapPanel>

    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>
      <ItemsControl ItemsSource="{Binding Filters}" Focusable="False" KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="{ui:T Register_Filter}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="tlfilter" Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=OneWay}"
                         Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Grid.Column="1" VerticalAlignment="Top">
        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="10,5,30,6" AutomationProperties.Name="{ui:T Register_Search}"/>
        <TextBlock Style="{StaticResource Placeholder}" Text="{ui:T Register_Search}" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,11,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
      </Grid>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="0" Margin="0">
        <Grid>
          <ListView x:Name="List" Style="{DynamicResource ListTable}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  ui:ListTable.Columns="40, 96, 1.6*:150, 1*:84, 1*:138" AutomationProperties.Name="{ui:T Page_tailoring}">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Header="">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Id}" ToolTip="{ui:T Register_MarkHint}" Margin="0" MinWidth="0"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{ui:T Register_ColId}" ui:ListTable.SortBy="Id">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Style="{StaticResource SeverityDot}"/>
                        <TextBlock Text="{Binding RuleId}" Style="{StaticResource CellCaption}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{ui:T Register_ColTitle}" ui:ListTable.SortBy="RuleId">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}"/>
                      <TextBlock Text="{Binding CategoryText}" Style="{StaticResource CellCaption}" Visibility="{Binding CategoryText, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{ui:T Register_ColScope}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding ScopeText}" Style="{StaticResource CellText}" ToolTip="{Binding ScopeText}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{ui:T Register_ColState}" ui:ListTable.SortBy="State">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <ui:TonePill Text="{Binding StateText}" Tone="{Binding StateTone}" HorizontalAlignment="Left"/>
                      <TextBlock Text="{Binding ReviewLine}" Style="{StaticResource CellCaption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" Visibility="{Binding ReviewLine, Converter={StaticResource NullToCollapsed}}"/>
                      <TextBlock Text="{Binding FlagsText}" Style="{StaticResource CellCaption}" Foreground="{DynamicResource Caution}" Visibility="{Binding FlagsText, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
          <TextBlock Text="{ui:T Tailoring_Empty}" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     Margin="24" MaxWidth="420" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
        </Grid>
      </Border>

      <!-- Rollenvorlagen (templates/tailoring) -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Text="{ui:T Tailoring_Templates}" Style="{StaticResource BodyStrong}" FontSize="13"/>
          <TextBlock Text="{ui:T Tailoring_TemplatesText}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
          <ItemsControl ItemsSource="{Binding RoleTemplates}" Focusable="False" Visibility="{Binding HasRoleTemplates, Converter={StaticResource BoolToVisible}}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Name}" Margin="0,0,8,6"
                        Command="{Binding DataContext.RoleTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{ui:T Tailoring_NoTemplates}" Style="{StaticResource Caption}" Visibility="{Binding HasRoleTemplates, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16" Focusable="False">
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
          <WrapPanel>
            <ui:TonePill Text="{Binding Selected.StateText}" Tone="{Binding Selected.StateTone}" Margin="0,0,8,4"/>
            <TextBlock Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,4">
              <Run Text="{Binding Selected.Id, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Selected.RuleId, Mode=OneWay}"/>
            </TextBlock>
          </WrapPanel>
          <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource SubtitleText}" FontSize="17" Margin="0,6,0,0"/>
          <TextBlock Text="{ui:T Tailoring_Reason}" Style="{StaticResource Label}"/>
          <TextBlock Text="{Binding DetailReason}" Style="{StaticResource DetailValue}"/>
          <TextBlock Text="{ui:T Register_Scope}" Style="{StaticResource Label}"/>
          <TextBlock Text="{Binding Selected.ScopeText}" Style="{StaticResource DetailValue}"/>
          <TextBlock Text="{Binding SelectedHosts}" Style="{StaticResource Caption}" Visibility="{Binding SelectedHosts, Converter={StaticResource NullToCollapsed}}"/>
          <TextBlock Text="{ui:T Register_Approval}" Style="{StaticResource Label}"/>
          <TextBlock Text="{Binding DetailApproval}" Style="{StaticResource DetailValue}"/>
          <TextBlock Text="{Binding DetailCreated}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
          <TextBlock Style="{StaticResource Caption}">
            <Run Text="{ui:T Register_ContentHash}"/><Run Text=" "/><Run Text="{Binding DetailHash, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
          </TextBlock>
          <StackPanel Visibility="{Binding HasComment, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="{ui:T Register_Comment}" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding DetailComment}" Style="{StaticResource DetailValue}"/>
          </StackPanel>
          <Border Style="{StaticResource InfoBox}" Background="{DynamicResource CriticalBg}" Margin="0,12,0,0" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisible}}">
            <ItemsControl ItemsSource="{Binding SelectedIssues}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13" Margin="0,0,0,3"/></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
