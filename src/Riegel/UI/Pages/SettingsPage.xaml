<UserControl x:Class="Riegel.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Riegel.UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,26,24" Focusable="False">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
      <TextBlock Text="{ui:T Settings_App}" Style="{StaticResource SectionText}" Margin="2,0,0,8"/>
      <ui:SettingCard Glyph="&#xF2B7;" Header="{ui:T Settings_Language}" Description="{ui:T Settings_LanguageText}" Badge="{Binding LanguagePreset}">
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" MinWidth="220" AutomationProperties.Name="{ui:T Settings_Language}"/>
      </ui:SettingCard>
      <ui:SettingCard Glyph="&#xE790;" Header="{ui:T Settings_Theme}" Description="{ui:T Settings_ThemeText}" Badge="{Binding ThemePreset}">
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="220" AutomationProperties.Name="{ui:T Settings_Theme}"/>
      </ui:SettingCard>
      <ui:SettingCard Glyph="&#xE8B7;" Header="{ui:T Settings_DefaultFolder}" Description="{ui:T Settings_DefaultFolderText}" Badge="{Binding FolderPreset}" Tag="Below">
        <Grid MinWidth="520">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding Folder, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{ui:T Settings_DefaultFolder}"/>
          <Button Grid.Column="1" Command="{Binding BrowseCommand}" Content="{ui:T Common_Browse}" Margin="8,0,0,0"/>
        </Grid>
      </ui:SettingCard>
      <ui:SettingCard Glyph="&#xE8A5;" Header="{ui:T Settings_ReportLanguage}" Description="{ui:T Settings_ReportLanguageText}" Badge="{Binding ReportLanguagePreset}">
        <ComboBox ItemsSource="{Binding ReportLanguages}" SelectedItem="{Binding ReportLanguage}" MinWidth="220" AutomationProperties.Name="{ui:T Settings_ReportLanguage}"/>
      </ui:SettingCard>

      <TextBlock Text="{ui:T Settings_Defaults}" Style="{StaticResource SectionText}"/>
      <TextBlock Text="{ui:T Settings_DefaultsText}" Style="{StaticResource Caption}" Margin="2,-4,0,8"/>
      <ui:SettingCard Glyph="&#xE823;" Header="{ui:T Settings_WarnDays}" Description="{ui:T Settings_WarnDaysText}" Badge="{Binding WarnPreset}">
        <TextBox Text="{Binding WarnDays, UpdateSourceTrigger=LostFocus}" Width="90" TextAlignment="Right" AutomationProperties.Name="{ui:T Settings_WarnDays}"/>
      </ui:SettingCard>
      <ui:SettingCard Glyph="&#xE81C;" Header="{ui:T Settings_StaleDays}" Description="{ui:T Settings_StaleDaysText}" Badge="{Binding StalePreset}">
        <TextBox Text="{Binding StaleDays, UpdateSourceTrigger=LostFocus}" Width="90" TextAlignment="Right" AutomationProperties.Name="{ui:T Settings_StaleDays}"/>
      </ui:SettingCard>
      <ui:SettingCard Glyph="&#xE895;" Header="{ui:T Settings_UpdateDays}" Description="{ui:T Settings_UpdateDaysText}" Badge="{Binding UpdatePreset}">
        <TextBox Text="{Binding UpdateMaxDays, UpdateSourceTrigger=LostFocus}" Width="90" TextAlignment="Right" AutomationProperties.Name="{ui:T Settings_UpdateDays}"/>
      </ui:SettingCard>
      <ui:SettingCard Glyph="&#xE77B;" Header="{ui:T Settings_UnusedDays}" Description="{ui:T Settings_UnusedDaysText}" Badge="{Binding UnusedPreset}">
        <TextBox Text="{Binding UnusedAccountDays, UpdateSourceTrigger=LostFocus}" Width="90" TextAlignment="Right" AutomationProperties.Name="{ui:T Settings_UnusedDays}"/>
      </ui:SettingCard>
      <Border Style="{StaticResource InfoBox}" Background="{DynamicResource CriticalBg}" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisible}}">
        <ItemsControl ItemsSource="{Binding Errors}" Focusable="False">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}">
            <Run Text="{ui:T Settings_StoredIn}"/><Run Text=" "/><Run Text="{Binding SettingsPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
            <Run Text="{ui:T Settings_PresetsIn}"/><Run Text=" "/><Run Text="{Binding DefaultsPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
          </TextBlock>
          <Button Command="{Binding OpenDataFolderCommand}" Content="{ui:T About_OpenFolder}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <!-- Einstellungen der geöffneten Anlage -->
      <StackPanel Visibility="{Binding HasPlantSettings, Converter={StaticResource BoolToVisible}}">
        <TextBlock Text="{Binding PlantTitle}" Style="{StaticResource SectionText}"/>
        <TextBlock Text="{ui:T Settings_PlantText}" Style="{StaticResource Caption}" Margin="2,-4,0,8"/>
        <Border Style="{StaticResource Card}" Padding="18,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{ui:T Settings_WarnDays}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <TextBox Grid.Column="1" Text="{Binding PlantWarnDays, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" TextAlignment="Right" Margin="0,0,24,8"
                     IsEnabled="{Binding CanWritePlant}" AutomationProperties.Name="{ui:T Settings_WarnDays}"/>
            <TextBlock Grid.Column="2" Text="{ui:T Settings_StaleDays}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <TextBox Grid.Column="3" Text="{Binding PlantStaleDays, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" TextAlignment="Right" Margin="0,0,0,8"
                     IsEnabled="{Binding CanWritePlant}" AutomationProperties.Name="{ui:T Settings_StaleDays}"/>
            <TextBlock Grid.Row="1" Text="{ui:T Settings_UpdateDays}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PlantUpdateMaxDays, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" TextAlignment="Right" Margin="0,0,24,8"
                     IsEnabled="{Binding CanWritePlant}" AutomationProperties.Name="{ui:T Settings_UpdateDays}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{ui:T Settings_UnusedDays}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PlantUnusedAccountDays, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" TextAlignment="Right" Margin="0,0,0,8"
                     IsEnabled="{Binding CanWritePlant}" AutomationProperties.Name="{ui:T Settings_UnusedDays}"/>
            <TextBlock Grid.Row="2" Text="{ui:T Settings_OperatorRole}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OperatorRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,24,8" IsEnabled="{Binding CanWritePlant}"
                     AutomationProperties.Name="{ui:T Settings_OperatorRole}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{ui:T Settings_ReportLanguage}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding ReportLanguages}" SelectedItem="{Binding PlantLanguage}" Margin="0,0,0,8" IsEnabled="{Binding CanWritePlant}"
                      AutomationProperties.Name="{ui:T Settings_ReportLanguage}"/>
            <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
              <Button Style="{DynamicResource AccentButton}" Command="{Binding SavePlantCommand}" Content="{ui:T Settings_SavePlant}"/>
              <ItemsControl ItemsSource="{Binding PlantErrors}" Focusable="False" Margin="12,0,0,0" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" Foreground="{DynamicResource Critical}"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
