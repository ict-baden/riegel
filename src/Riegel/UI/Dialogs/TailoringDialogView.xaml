<UserControl x:Class="Riegel.UI.Dialogs.TailoringDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Riegel.UI">
  <StackPanel>
    <TextBlock Style="{StaticResource Body}" FontSize="13">
      <Run Text="{Binding RuleId, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding RuleTitle, Mode=OneWay}"/>
    </TextBlock>
    <TextBlock Text="{ui:T TailoringDialog_Intro}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
    <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0" Visibility="{Binding WasApproved, Converter={StaticResource BoolToVisible}}">
      <TextBlock Text="{ui:T Dialog_ChangeResetsApproval}" Style="{StaticResource Body}" FontSize="13"/>
    </Border>
    <TextBlock Text="{ui:T Register_Scope}" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" AutomationProperties.Name="{ui:T Register_Scope}"/>
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding ReasonCounter}" Style="{StaticResource Caption}" Margin="0,10,0,3"/>
      <TextBlock Text="{ui:T Tailoring_Reason}" Style="{StaticResource Label}"/>
    </DockPanel>
    <TextBox Style="{DynamicResource MultiLineBox}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MinHeight="84" AutomationProperties.Name="{ui:T Tailoring_Reason}"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{ui:T Register_CreatedBy}" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding CreatedByRole, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ui:T Register_CreatedBy}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="{ui:T Register_Comment}" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ui:T Register_Comment}"/>
      </StackPanel>
    </Grid>
    <TextBlock Text="{ui:T TailoringDialog_PendingNote}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DialogIssues}" Focusable="False" IsTabStop="False"/>
  </StackPanel>
</UserControl>
