<UserControl x:Class="Riegel.UI.Dialogs.GroupsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Riegel.UI">
  <StackPanel>
    <TextBlock Text="{ui:T Groups_Intro}" Style="{StaticResource Body}" FontSize="13"/>
    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,10,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Id}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{ui:T Groups_Name}"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" AutomationProperties.Name="{ui:T Groups_Role}"/>
            <Button Grid.Column="4" Style="{DynamicResource GhostButton}" Margin="6,0,0,0" ToolTip="{ui:T Groups_Remove}" AutomationProperties.Name="{ui:T Groups_Remove}"
                    Click="Remove_Click">
              <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Command="{Binding AddCommand}" Content="{ui:T Groups_Add}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
  </StackPanel>
</UserControl>
