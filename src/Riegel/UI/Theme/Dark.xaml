<!-- Ergänzt Fluent.Dark.xaml um die Riegel-eigenen Farben (Status, Schwere, Marke) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ControlOff" Color="#00000000"/>
  <SolidColorBrush x:Key="ControlOffStroke" Color="#9AFFFFFF"/>
  <SolidColorBrush x:Key="Knob" Color="#D0FFFFFF"/>

  <SolidColorBrush x:Key="SevHigh" Color="#FF99A4"/>
  <SolidColorBrush x:Key="SevHighBg" Color="#33FF5A6A"/>
  <SolidColorBrush x:Key="SevMedium" Color="#FFB46B"/>
  <SolidColorBrush x:Key="SevMediumBg" Color="#33FF8C1A"/>
  <SolidColorBrush x:Key="SevLow" Color="#F2D45C"/>
  <SolidColorBrush x:Key="SevLowBg" Color="#29F2D45C"/>
  <SolidColorBrush x:Key="SevInfo" Color="#B4B4B4"/>
  <SolidColorBrush x:Key="SevInfoBg" Color="#1AFFFFFF"/>

  <SolidColorBrush x:Key="StatusPass" Color="#6CCB5F"/>
  <SolidColorBrush x:Key="StatusPassBg" Color="#266CCB5F"/>
  <SolidColorBrush x:Key="StatusFail" Color="#FF99A4"/>
  <SolidColorBrush x:Key="StatusFailBg" Color="#33FF5A6A"/>
  <SolidColorBrush x:Key="StatusException" Color="#FFC966"/>
  <SolidColorBrush x:Key="StatusExceptionBg" Color="#2EFFB020"/>
  <SolidColorBrush x:Key="StatusOutOfScope" Color="#9DB8DC"/>
  <SolidColorBrush x:Key="StatusOutOfScopeBg" Color="#2B9DB8DC"/>
  <SolidColorBrush x:Key="StatusNotApplicable" Color="#B4B4B4"/>
  <SolidColorBrush x:Key="StatusNotApplicableBg" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="StatusNotCheckable" Color="#C9A8F0"/>
  <SolidColorBrush x:Key="StatusNotCheckableBg" Color="#2BC9A8F0"/>
  <SolidColorBrush x:Key="StatusInfo" Color="#8CC8FF"/>
  <SolidColorBrush x:Key="StatusInfoBg" Color="#268CC8FF"/>

  <SolidColorBrush x:Key="Good" Color="#6CCB5F"/>
  <SolidColorBrush x:Key="GoodBg" Color="#266CCB5F"/>
  <SolidColorBrush x:Key="Caution" Color="#FFC966"/>
  <SolidColorBrush x:Key="CautionBg" Color="#2EFFB020"/>
  <SolidColorBrush x:Key="Critical" Color="#FF99A4"/>
  <SolidColorBrush x:Key="CriticalBg" Color="#33FF5A6A"/>

  <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F3821D" Offset="0"/>
    <GradientStop Color="#AC281B" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#33F3821D" Offset="0"/>
    <GradientStop Color="#1AAC281B" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ScoreTrack" Color="#1FFFFFFF"/>
</ResourceDictionary>
