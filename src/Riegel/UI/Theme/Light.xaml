<!-- Ergänzt Fluent.Light.xaml um die Riegel-eigenen Farben (Status, Schwere, Marke) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ControlOff" Color="#06000000"/>
  <SolidColorBrush x:Key="ControlOffStroke" Color="#72000000"/>
  <SolidColorBrush x:Key="Knob" Color="#9E000000"/>

  <!-- Schwere (wie in den Berichten): hoch rot, mittel orange, niedrig gelb; auf hellem Grund dunkler gewählt -->
  <SolidColorBrush x:Key="SevHigh" Color="#C42B1C"/>
  <SolidColorBrush x:Key="SevHighBg" Color="#1FC42B1C"/>
  <SolidColorBrush x:Key="SevMedium" Color="#B5530A"/>
  <SolidColorBrush x:Key="SevMediumBg" Color="#1FE06A10"/>
  <SolidColorBrush x:Key="SevLow" Color="#7A5E00"/>
  <SolidColorBrush x:Key="SevLowBg" Color="#29D9A400"/>
  <SolidColorBrush x:Key="SevInfo" Color="#5E5E5E"/>
  <SolidColorBrush x:Key="SevInfoBg" Color="#14000000"/>

  <!-- Status (spec 2.7) -->
  <SolidColorBrush x:Key="StatusPass" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="StatusPassBg" Color="#1A0F7B0F"/>
  <SolidColorBrush x:Key="StatusFail" Color="#C42B1C"/>
  <SolidColorBrush x:Key="StatusFailBg" Color="#1FC42B1C"/>
  <SolidColorBrush x:Key="StatusException" Color="#9A5B00"/>
  <SolidColorBrush x:Key="StatusExceptionBg" Color="#24D98A00"/>
  <SolidColorBrush x:Key="StatusOutOfScope" Color="#3C5A80"/>
  <SolidColorBrush x:Key="StatusOutOfScopeBg" Color="#1A3C5A80"/>
  <SolidColorBrush x:Key="StatusNotApplicable" Color="#616161"/>
  <SolidColorBrush x:Key="StatusNotApplicableBg" Color="#12000000"/>
  <SolidColorBrush x:Key="StatusNotCheckable" Color="#6B3FA0"/>
  <SolidColorBrush x:Key="StatusNotCheckableBg" Color="#1A6B3FA0"/>
  <SolidColorBrush x:Key="StatusInfo" Color="#005A9E"/>
  <SolidColorBrush x:Key="StatusInfoBg" Color="#1A005A9E"/>

  <SolidColorBrush x:Key="Good" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="GoodBg" Color="#1A0F7B0F"/>
  <SolidColorBrush x:Key="Caution" Color="#9A5B00"/>
  <SolidColorBrush x:Key="CautionBg" Color="#1FD98A00"/>
  <SolidColorBrush x:Key="Critical" Color="#C42B1C"/>
  <SolidColorBrush x:Key="CriticalBg" Color="#1AC42B1C"/>

  <!-- Marke: Verlauf des App-Icons (#F3821D → #AC281B), auf Flächen dezent -->
  <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F3821D" Offset="0"/>
    <GradientStop Color="#AC281B" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#24F3821D" Offset="0"/>
    <GradientStop Color="#12AC281B" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ScoreTrack" Color="#14000000"/>
</ResourceDictionary>
