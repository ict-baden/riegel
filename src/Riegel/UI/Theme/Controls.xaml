<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Riegel.UI">

  <!-- Schriften und Grundstile (weitgehend von Zutritt übernommen); Farben aus den Fluent-Schlüsseln und Light/Dark.xaml.
       AccentButton, GhostButton, MultiLineBox und ListTable legt ThemeManager zur Laufzeit an (BasedOn Fluent). -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <ui:EmptyToVisibleConverter x:Key="EmptyToVisible"/>
  <ui:BoolToVisibleConverter x:Key="BoolToVisible"/>
  <ui:NullToCollapsedConverter x:Key="NullToCollapsed"/>
  <ui:PercentWidthConverter x:Key="PercentWidth"/>

  <!-- ========== Text ========== -->
  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="SubtitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="SectionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Margin" Value="2,18,0,8"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="BodyStrong" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,10,0,3"/>
  </Style>
  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  </Style>
  <!-- Grauer Hinweis über leeren Eingabefeldern (WPF-TextBox kennt keinen Platzhalter) -->
  <Style x:Key="Placeholder" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Margin" Value="12,6,32,0"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <!-- Zellen in Tabellen: einzeilig, abgeschnitten, voller Text als Tooltip -->
  <Style x:Key="CellText" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="700"/>
  </Style>
  <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>
  <Style x:Key="CellCaption" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- ========== Fokus ========== -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
                     Background="Transparent" TextWrapping="Wrap"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="T" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== Schalter (CheckBox als ToggleSwitch, wie Zutritt) ========== -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="State" Text="{ui:T Toggle_Off}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" MinWidth="22" TextAlignment="Right"/>
            <Grid Width="40" Height="20">
              <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource ControlOff}"
                      BorderBrush="{DynamicResource ControlOffStroke}" BorderThickness="1"/>
              <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Knob}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
              <Setter TargetName="State" Property="Text" Value="{ui:T Toggle_On}"/>
              <Setter TargetName="Knob" Property="Margin" Value="24,0,0,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== Navigation links (wie Zutritt, plus Abzeichen) ========== -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="GroupName" Value="nav"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent"/>
            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
            <Grid Margin="14,6,10,6" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              <Border x:Name="Badge" Grid.Column="2" CornerRadius="9" MinWidth="24" Height="18" Padding="6,0" Margin="6,0,0,0"
                      Background="{DynamicResource SevInfoBg}">
                <TextBlock x:Name="BadgeText" Text="{Binding (ui:Nav.Badge), RelativeSource={RelativeSource TemplatedParent}}"
                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ui:Nav.Badge" Value="{x:Null}">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="ui:Nav.Badge" Value="">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="ui:Nav.BadgeTone" Value="High">
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SevHighBg}"/>
              <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SevHigh}"/>
            </Trigger>
            <Trigger Property="ui:Nav.BadgeTone" Value="Medium">
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SevMediumBg}"/>
              <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SevMedium}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
              <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== Filter-Chips ========== -->
  <Style x:Key="Chip" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="10,4,11,4"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" CornerRadius="15" Padding="{TemplateBinding Padding}" BorderThickness="1"
                  Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtle}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Chips als RadioButton (einer aus einer Gruppe) -->
  <Style x:Key="ChoiceChip" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="10,4,11,4"/>
    <Setter Property="Margin" Value="0,0,6,6"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" CornerRadius="15" Padding="{TemplateBinding Padding}" BorderThickness="1"
                  Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtle}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== Karten ========== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
  <Style x:Key="HeroCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource HeroBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="22,18"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
  <!-- Hinweisleiste innerhalb einer Seite (Prüfermodus, Platzhalter, Banner) -->
  <Style x:Key="InfoBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CautionBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="TagBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="7,2"/>
    <Setter Property="Margin" Value="0,0,6,4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="TagText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- Schwere als Punkt in Tabellenzeilen -->
  <Style x:Key="SeverityDot" TargetType="Ellipse">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Fill" Value="{DynamicResource SevInfo}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Severity}" Value="High">
        <Setter Property="Fill" Value="{DynamicResource SevHigh}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Severity}" Value="Medium">
        <Setter Property="Fill" Value="{DynamicResource SevMedium}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Severity}" Value="Low">
        <Setter Property="Fill" Value="{DynamicResource SevLow}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ========== Schwere ========== -->
  <Style TargetType="ui:SeverityPill">
    <Setter Property="Foreground" Value="{DynamicResource SevInfo}"/>
    <Setter Property="Background" Value="{DynamicResource SevInfoBg}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:SeverityPill">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="7,2,9,2">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
              <TextBlock x:Name="T" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontSize="12"
                         FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Compact" Value="True">
              <Setter TargetName="T" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
              <Setter TargetName="Bd" Property="Padding" Value="0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Severity" Value="High">
        <Setter Property="Foreground" Value="{DynamicResource SevHigh}"/>
        <Setter Property="Background" Value="{DynamicResource SevHighBg}"/>
      </Trigger>
      <Trigger Property="Severity" Value="Medium">
        <Setter Property="Foreground" Value="{DynamicResource SevMedium}"/>
        <Setter Property="Background" Value="{DynamicResource SevMediumBg}"/>
      </Trigger>
      <Trigger Property="Severity" Value="Low">
        <Setter Property="Foreground" Value="{DynamicResource SevLow}"/>
        <Setter Property="Background" Value="{DynamicResource SevLowBg}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ========== Status ========== -->
  <Style TargetType="ui:StatusPill">
    <Setter Property="Foreground" Value="{DynamicResource StatusInfo}"/>
    <Setter Property="Background" Value="{DynamicResource StatusInfoBg}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:StatusPill">
          <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="7,2,9,2">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
              <TextBlock Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="SemiBold"
                         Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Status" Value="Pass">
        <Setter Property="Foreground" Value="{DynamicResource StatusPass}"/>
        <Setter Property="Background" Value="{DynamicResource StatusPassBg}"/>
      </Trigger>
      <Trigger Property="Status" Value="Fail">
        <Setter Property="Foreground" Value="{DynamicResource StatusFail}"/>
        <Setter Property="Background" Value="{DynamicResource StatusFailBg}"/>
      </Trigger>
      <Trigger Property="Status" Value="Exception">
        <Setter Property="Foreground" Value="{DynamicResource StatusException}"/>
        <Setter Property="Background" Value="{DynamicResource StatusExceptionBg}"/>
      </Trigger>
      <Trigger Property="Status" Value="OutOfScope">
        <Setter Property="Foreground" Value="{DynamicResource StatusOutOfScope}"/>
        <Setter Property="Background" Value="{DynamicResource StatusOutOfScopeBg}"/>
      </Trigger>
      <Trigger Property="Status" Value="NotApplicable">
        <Setter Property="Foreground" Value="{DynamicResource StatusNotApplicable}"/>
        <Setter Property="Background" Value="{DynamicResource StatusNotApplicableBg}"/>
      </Trigger>
      <Trigger Property="Status" Value="NotCheckable">
        <Setter Property="Foreground" Value="{DynamicResource StatusNotCheckable}"/>
        <Setter Property="Background" Value="{DynamicResource StatusNotCheckableBg}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ========== Kennzeichen mit Farbton (Zustände der Registereinträge) ========== -->
  <Style TargetType="ui:TonePill">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:TonePill">
          <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="7,2">
            <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="Good">
        <Setter Property="Foreground" Value="{DynamicResource Good}"/>
        <Setter Property="Background" Value="{DynamicResource GoodBg}"/>
      </Trigger>
      <Trigger Property="Tone" Value="Caution">
        <Setter Property="Foreground" Value="{DynamicResource Caution}"/>
        <Setter Property="Background" Value="{DynamicResource CautionBg}"/>
      </Trigger>
      <Trigger Property="Tone" Value="Critical">
        <Setter Property="Foreground" Value="{DynamicResource Critical}"/>
        <Setter Property="Background" Value="{DynamicResource CriticalBg}"/>
      </Trigger>
      <Trigger Property="Tone" Value="Info">
        <Setter Property="Foreground" Value="{DynamicResource StatusInfo}"/>
        <Setter Property="Background" Value="{DynamicResource StatusInfoBg}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ========== Kennzahl-Kachel ========== -->
  <Style TargetType="ui:StatTile">
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:StatTile">
          <Border Style="{StaticResource Card}" Margin="0" Padding="14,10,12,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="16" Height="30" Margin="0,0,10,0" VerticalAlignment="Top">
                <TextBlock x:Name="Ic" Text="{TemplateBinding Glyph}" Style="{StaticResource Icon}" FontSize="15"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <Ellipse x:Name="Dot" Width="10" Height="10" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{TemplateBinding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource Caption}"/>
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Glyph" Value="{x:Null}">
              <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Tone" Value="High">
              <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevHigh}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Medium">
              <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevMedium}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Low">
              <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SevLow}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Good">
              <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource Good}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Caution">
              <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource Caution}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== Einstellungszeile (wie Zutritt) ========== -->
  <Style TargetType="ui:SettingCard">
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ui:SettingCard">
          <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="16,10" MinHeight="62">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="Ic" Text="{TemplateBinding Glyph}" Style="{StaticResource Icon}" FontSize="18" Margin="2,0,18,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <WrapPanel>
                  <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Body}" Margin="0,0,8,0"/>
                  <Border x:Name="BadgeBox" Style="{StaticResource TagBorder}" Margin="0" Background="{DynamicResource StatusInfoBg}">
                    <TextBlock Text="{TemplateBinding Badge}" Style="{StaticResource TagText}" Foreground="{DynamicResource StatusInfo}"/>
                  </Border>
                </WrapPanel>
                <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
              </StackPanel>
              <ContentPresenter x:Name="CP" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Description" Value="{x:Null}">
              <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Badge" Value="{x:Null}">
              <Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Glyph" Value="{x:Null}">
              <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Tag" Value="Below">
              <Setter TargetName="CP" Property="Grid.Row" Value="1"/>
              <Setter TargetName="CP" Property="Grid.Column" Value="1"/>
              <Setter TargetName="CP" Property="Grid.ColumnSpan" Value="2"/>
              <Setter TargetName="CP" Property="Margin" Value="0,10,0,2"/>
              <Setter TargetName="CP" Property="HorizontalAlignment" Value="Left"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fehler und Warnungen eines Bearbeitungsdialogs (Errors/Warnings mit Code) -->
  <DataTemplate x:Key="DialogIssues">
    <StackPanel Margin="0,12,0,0">
      <Border Style="{StaticResource InfoBox}" Background="{DynamicResource CriticalBg}" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisible}}">
        <ItemsControl ItemsSource="{Binding Errors}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="12" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Critical}"/>
                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13" MaxWidth="600"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Border Style="{StaticResource InfoBox}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisible}}">
        <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Caution}"/>
                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13" MaxWidth="600"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- Feld im Detailbereich: Beschriftung über dem Wert -->
  <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="13"/>
  </Style>
</ResourceDictionary>
