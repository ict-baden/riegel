<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plattformneutral: Auswertung, Register, Vergleich und Berichte laufen auch unter Linux (Prüfer, CI von
         Anlagenbauern). Alles Windows-Eigene steckt in Riegel.Platform.Windows hinter Riegel.Core.Services.IPlatform. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Riegel.Core</RootNamespace>
    <Description>Auswertung, Register, Vergleich und Berichte für Riegel – ohne Oberfläche und ohne Systemaufrufe.</Description>
    <!-- Eine nur unter Windows verfügbare API darf hier nie hineinrutschen -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Ausgelieferte Pakete. Jede Änderung braucht einen Eintrag in THIRD-PARTY-NOTICES.txt (Test ThirdPartyNoticesTests)
    und die Prüfung der Lizenz (richtlinien/02, spec 7.1). Gesehen am 2026-10-18 über die NuGet-API:
    - ClosedXML 0.105.1, MIT – https://api.nuget.org/v3-flatcontainer/closedxml/0.105.1/closedxml.nuspec
      (verlangt SixLabors.Fonts [1.0.0, 3.0.0))
    - SixLabors.Fonts 1.0.1 (neueste 1.x), Apache-2.0 – https://api.nuget.org/v3-flatcontainer/sixlabors.fonts/1.0.1/sixlabors.fonts.nuspec
      Direkt festgelegt: ab 2.0 gilt die Six Labors Split License (Dependabot ignoriert >= 2).
    - PDFsharp-MigraDoc 6.2.4, MIT – https://api.nuget.org/v3-flatcontainer/pdfsharp-migradoc/6.2.4/pdfsharp-migradoc.nuspec
      Ab 6.5.0 AGPL-3.0-only (https://api.nuget.org/v3-flatcontainer/pdfsharp-migradoc/6.5.0/pdfsharp-migradoc.nuspec),
      Dependabot ignoriert >= 6.5.
    - System.Security.Cryptography.Pkcs 10.0.13, MIT – https://api.nuget.org/v3-flatcontainer/system.security.cryptography.pkcs/10.0.13/system.security.cryptography.pkcs.nuspec
      Nur, weil PDFsharp 8.0.1 mitbringt (bekannte Schwachstellen GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7, wie in Zutritt).
  -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.1" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Texte (Richtlinie 13): <Name>Strings.resx = Englisch (Rückfallsprache), dazu .de/.es/.fr/.zh-Hans. Die Klassen
       erzeugt der Build (Muster aus Lupe), keine Designer-Dateien im Repo. Je Paket eine eigene Datei (spec 7.10). -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\CommonStrings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Riegel.Core.Resources"
                      StronglyTypedClassName="CommonStrings" StronglyTypedFileName="$(IntermediateOutputPath)CommonStrings.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Resources\EngineStrings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Riegel.Core.Resources"
                      StronglyTypedClassName="EngineStrings" StronglyTypedFileName="$(IntermediateOutputPath)EngineStrings.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Resources\ParsingStrings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Riegel.Core.Resources"
                      StronglyTypedClassName="ParsingStrings" StronglyTypedFileName="$(IntermediateOutputPath)ParsingStrings.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Resources\WorkflowStrings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Riegel.Core.Resources"
                      StronglyTypedClassName="WorkflowStrings" StronglyTypedFileName="$(IntermediateOutputPath)WorkflowStrings.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Resources\PdfStrings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Riegel.Core.Resources"
                      StronglyTypedClassName="PdfStrings" StronglyTypedFileName="$(IntermediateOutputPath)PdfStrings.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Resources\DataOutputStrings.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Riegel.Core.Resources"
                      StronglyTypedClassName="DataOutputStrings" StronglyTypedFileName="$(IntermediateOutputPath)DataOutputStrings.g.cs" PublicClass="true" />
  </ItemGroup>

  <!-- Regelwerk und Vorlagen (spec 2.3, 2.12): im Repo als lesbare JSON-Dateien, eingebettet mit stabilen Namen
       "rules/<Pfad>" und "templates/<Pfad>" (immer mit "/", siehe Ziel RiegelNormalizeLogicalNames unten). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\rules\**\*.json" Link="rules\%(RecursiveDir)%(Filename)%(Extension)"
                      LogicalName="rules/%(RecursiveDir)%(Filename)%(Extension)" RiegelLogicalName="true" WithCulture="false" />
    <EmbeddedResource Include="..\..\templates\**\*.json" Link="templates\%(RecursiveDir)%(Filename)%(Extension)"
                      LogicalName="templates/%(RecursiveDir)%(Filename)%(Extension)" RiegelLogicalName="true" WithCulture="false" />
    <!-- Info-Seite und die Befehle info und licenses: Lizenztexte und die Sammler-Version, auch in der einzelnen Exe ohne Dateien daneben -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\Riegel.Collector\collector-version.txt" LogicalName="collector-version.txt" />
  </ItemGroup>

  <!-- %(RecursiveDir) enthält unter Windows "\" – die Namen der Ressourcen sollen auf jedem System gleich sein -->
  <Target Name="RiegelNormalizeLogicalNames" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Condition="'%(EmbeddedResource.RiegelLogicalName)' == 'true'">
        <LogicalName>$([System.String]::Copy('%(EmbeddedResource.LogicalName)').Replace('\', '/'))</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Riegel.Tests" />
  </ItemGroup>
</Project>
