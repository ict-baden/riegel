<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Konsolenprogramm (spec 4.2): Riegel.Cli.exe unter Windows (Konsolen-Subsystem, $LASTEXITCODE verlässlich),
         riegel-linux-x64/-arm64 unter Linux. Windows-Ziel mit Erfassung über Riegel.Platform.Windows, net10.0 ohne. -->
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- auch unter Linux wiederherstellbar (das Windows-Ziel wird dort nur nicht gebaut und ausgeführt) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Riegel.Cli</RootNamespace>
    <AssemblyName>Riegel.Cli</AssemblyName>
    <Description>Riegel (Härtungs-Check) – Befehlszeile</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Riegel.Commands\Riegel.Commands.csproj" />
    <ProjectReference Include="..\Riegel.Core\Riegel.Core.csproj" />
  </ItemGroup>

  <!-- Nur Windows: Erfassung dieses Rechners (Riegel.Cli.exe collect) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\Riegel.Platform.Windows\Riegel.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- Lizenztexte neben die Exe (ZIP, MSI); eingebettet sind sie in Riegel.Core -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Riegel.Tests" />
  </ItemGroup>
</Project>
