<?xml version="1.0" encoding="utf-8"?>
<!-- Wird zu Riegel.Collector.exe.config: zuerst CLR 4 (Windows 8 und neuer), sonst CLR 2 (.NET 3.5.1 auf Windows 7 SP1).
     Ohne diese Datei fragt Windows 8 und neuer nach der Installation von .NET 3.5 (spec 2.9). -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0"/>
    <supportedRuntime version="v2.0.50727"/>
  </startup>
</configuration>
