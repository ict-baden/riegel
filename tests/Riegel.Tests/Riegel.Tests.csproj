<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-Ziel: alle Tests (Core, Befehle, Windows-Anbindung, App). net10.0: nur die plattformneutralen Tests, die
         auch unter Linux laufen (ohne Windows/**). Tests ändern nie die Konfiguration des Rechners: nur Fixtures,
         Temp-Ordner und lesende Abfragen (spec 8). -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <!-- auch unter Linux wiederherstellbar (das Windows-Ziel wird dort nur nicht ausgeführt) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Riegel.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    Nur für Tests, nicht ausgeliefert (gesehen 2026-10-18 über die NuGet-API):
    - Microsoft.NET.Test.Sdk 18.11.0, MIT; xunit 2.9.3, Apache-2.0; xunit.runner.visualstudio 4.0.1, Apache-2.0
      (dieselben Versionen wie Zutritt)
    - JsonSchema.Net 8.0.5, MIT – https://api.nuget.org/v3-flatcontainer/jsonschema.net/8.0.5/jsonschema.net.nuspec
      Die neueste Version 9.4.1 (und alle ab 9.0.0) steht unter der OSMF-EULA
      (https://api.nuget.org/v3-flatcontainer/jsonschema.net/9.4.1/jsonschema.net.nuspec: license type="file" OSMFEULA.txt),
      nicht MIT – deshalb 8.0.5, Dependabot ignoriert >= 9. Bringt JsonPointer.Net 6.0.1, Json.More.Net 2.2.0 und
      Humanizer.Core 3.0.1 mit (alle MIT laut nuspec).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Riegel.Core\Riegel.Core.csproj" />
    <ProjectReference Include="..\..\src\Riegel.Commands\Riegel.Commands.csproj" />
    <!-- RuleTool nur bauen (die RuleTool-Tests starten es als eigenen Prozess), auch im Linux-Job -->
    <ProjectReference Include="..\..\tools\RuleTool\RuleTool.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Nur unter Windows: Windows-Anbindung, die WPF-App und der gebaute net35-Sammler (Referenztest, spec 8.13) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\..\src\Riegel.Platform.Windows\Riegel.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\Riegel\Riegel.csproj" />
    <ProjectReference Include="..\..\src\Riegel.Collector\Riegel.Collector.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net35" Private="false" />
    <!-- Riegel.Cli.exe als eigener Prozess (ConsoleHostTests): nur bauen -->
    <ProjectReference Include="..\..\src\Riegel.Cli\Riegel.Cli.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net10.0-windows" Private="false" />
  </ItemGroup>

  <!-- Das Sammler-Paket neben die Tests (wie collector\ neben Riegel.exe in MSI und ZIP), für „Sammler auf Datenträger
       kopieren“ (O15) im Demo-Bericht und in den Ende-zu-Ende-Tests -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <None Include="..\..\src\Riegel.Collector\bin\$(Configuration)\net35\Riegel.Collector.exe" Link="collector\Riegel.Collector.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Riegel.Collector\bin\$(Configuration)\net35\Riegel.Collector.exe.config" Link="collector\Riegel.Collector.exe.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\collect-builtin\collect-builtin.cmd" Link="collector\collect-builtin.cmd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Riegel.Collector\README.txt" Link="collector\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="collector\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="collector\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Windows\**" />
  </ItemGroup>

  <!-- Wo der Test den gebauten Sammler findet (gleiche Konfiguration wie der Testlauf) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RiegelCollectorExe</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\src\Riegel.Collector\bin\$(Configuration)\net35\Riegel.Collector.exe</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Fixtures neben die Tests; Unterordner und Dateinamen bleiben erhalten -->
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
