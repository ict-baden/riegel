        {
          "name": "nothing found",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "ok",
              "value": {
                "rows": [
                  {
                    "Name": "Spooler",
                    "DisplayName": "Spooler",
                    "State": "Running",
                    "StartMode": "Auto"
                  }
                ]
              }
            }
          },
          "expect": "info"
        },
        {
          "name": "everything not collected",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "notCollected"
            },
            "reg:HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall": {
              "status": "notCollected"
            }
          },
          "expect": "notCheckable"
        }
      ]
    },
