            "wmi:root\\cimv2:Win32_Service": {
              "status": "ok",
              "value": {
                "value": 1
              }
            }
          },
          "expect": "notCheckable"
        },
        {
          "name": "builtin: registry Start 4",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "coverage": [
            {
              "root": "HKLM\\SYSTEM\\CurrentControlSet\\Services",
              "recursive": true,
              "maxDepth": 1,
              "complete": true,
              "deniedSubkeys": []
            }
          ],
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "notCollected"
            },
            "reg:HKLM\\SYSTEM\\CurrentControlSet\\Services\\RemoteRegistry": {
              "status": "ok",
              "value": {
                "values": {
                  "Start": {
                    "t": "dword",
                    "v": 4
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "pass"
        },
        {
          "name": "builtin: registry Start 2",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "coverage": [
            {
              "root": "HKLM\\SYSTEM\\CurrentControlSet\\Services",
              "recursive": true,
              "maxDepth": 1,
              "complete": true,
              "deniedSubkeys": []
            }
          ],
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "notCollected"
            },
            "reg:HKLM\\SYSTEM\\CurrentControlSet\\Services\\RemoteRegistry": {
              "status": "ok",
              "value": {
                "values": {
                  "Start": {
                    "t": "dword",
                    "v": 2
                  }
                },
                "subkeys": []
              }
            }
          },
          "expect": "fail"
        },
        {
          "name": "builtin: service key absent",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "coverage": [
            {
              "root": "HKLM\\SYSTEM\\CurrentControlSet\\Services",
              "recursive": true,
              "maxDepth": 1,
              "complete": true,
              "deniedSubkeys": []
            }
          ],
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "notCollected"
            }
          },
          "expect": "pass"
        },
        {
          "name": "n/a: client only",
          "machine": {
            "build": 20348,
            "ubr": 4294,
            "edition": "ServerStandard",
            "installationType": "Server",
            "productType": 3,
            "domainRole": 3,
            "isAdmin": true
          },
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "ok",
              "value": {
                "rows": []
              }
            }
          },
          "expect": "notApplicable"
        }
      ]
