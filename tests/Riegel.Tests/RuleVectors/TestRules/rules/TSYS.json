      "since": "2026.10",
      "state": "active",
      "category": "services",
      "severity": "medium",
      "kind": "check",
      "title": {
        "de": "Testregel: Dienst deaktiviert",
        "en": "Test rule: service disabled"
      },
      "rationale": {
        "de": "Prüft die Engine (erfundene Testregel).",
        "en": "Exercises the engine (invented test rule)."
      },
      "appliesTo": {
        "os": [
          "client"
        ],
        "domain": "any",
        "excludeDc": false,
        "when": []
      },
      "needsAdmin": false,
      "check": {
        "type": "service",
        "name": "RemoteRegistry",
        "startMode": [
          "Disabled"
        ],
        "ifAbsent": "pass"
      },
      "references": [],
      "textSources": [],
      "verified": [],
      "tests": [
        {
          "name": "disabled",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "ok",
              "value": {
                "rows": [
                  {
                    "Name": "RemoteRegistry",
                    "DisplayName": "RemoteRegistry",
                    "State": "Stopped",
                    "StartMode": "Disabled"
                  }
                ]
              }
            }
          },
          "expect": "pass"
        },
        {
          "name": "case-insensitive name",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "ok",
              "value": {
                "rows": [
                  {
                    "Name": "remoteregistry",
                    "DisplayName": "remoteregistry",
                    "State": "Stopped",
                    "StartMode": "Disabled"
                  }
                ]
              }
            }
          },
          "expect": "pass"
        },
        {
          "name": "auto",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "ok",
              "value": {
                "rows": [
                  {
                    "Name": "RemoteRegistry",
                    "DisplayName": "RemoteRegistry",
                    "State": "Running",
                    "StartMode": "Auto"
                  }
                ]
              }
            }
          },
          "expect": "fail"
        },
        {
          "name": "absent",
          "machine": {
            "build": 26100,
            "ubr": 6899,
            "edition": "Professional",
            "installationType": "Client",
            "productType": 1,
            "domainRole": 0,
            "isAdmin": true
          },
          "items": {
            "wmi:root\\cimv2:Win32_Service": {
              "status": "ok",
              "value": {
                "rows": [
                  {
                    "Name": "Spooler",
                    "DisplayName": "Spooler",
                    "State": "Running",
                    "StartMode": "Auto"
                  }
