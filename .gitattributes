# Zeilenenden passend zur .editorconfig (richtlinien/02): im Repo immer LF, beim Auschecken LF –
# nur Windows-Skripte und die Solution mit CRLF. Gilt unabhängig von core.autocrlf des Klons.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

# Binärdateien nie umwandeln
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.zip binary
*.ttf binary
*.ttc binary
*.otf binary
*.gz binary
*.exe binary
*.dll binary
*.msi binary

# Fixtures der Windows-Bordmittel (UTF-16-.reg/.inf, cmd-Ausgaben mit CRLF): Bytes genau so, wie Windows sie schreibt
tests/Riegel.Tests/Fixtures/**/*.riegel-builtin/** -text

# README des Sammlers wird auf Windows 7/XP im alten Editor geöffnet: CRLF (und UTF-8 mit BOM), sonst eine einzige Zeile
src/Riegel.Collector/README.txt text eol=crlf
