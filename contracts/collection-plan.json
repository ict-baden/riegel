{
  "schema": "riegel.collection-plan/1",
  "version": 1,
  "limits": {
    "maxValuesTotal": 50000,
    "recursiveMaxDepth": 8,
    "maxBinaryBytes": 4096,
    "toolTimeoutSeconds": 60,
    "maxRawTextBytes": 4194304,
    "windowsUpdateHistoryEntries": 100,
    "tempPathMaxChars": 127,
    "maxStringChars": 1048576
  },
  "registry": {
    "roots": [
      {
        "path": "HKLM\\SOFTWARE\\Policies",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "Group Policy registry settings (incl. legacy LAPS AdmPwd, Windows Defender, Terminal Services, WinRM, DNSClient)"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "System/Explorer policies incl. UAC and the Windows LAPS GPO root"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\PolicyManager\\current\\device",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "MDM (CSP) policy values"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "LSA incl. MSV1_0; RunAsPPL, LmCompatibilityLevel, anonymous restrictions"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "WDigest and SCHANNEL protocols/ciphers"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "RDP incl. WinStations\\RDP-Tcp"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "VBS/HVCI/Credential Guard configuration (runtime comes from Win32_DeviceGuard)"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "NetBIOS over TCP/IP incl. Interfaces\\Tcpip_{GUID}"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "local firewall store incl. FirewallRules"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Windows Defender",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "as readable; some subkeys are denied without admin (deniedSubkeys)"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Policies\\LAPS",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "Windows LAPS CSP root"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\LAPS",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "Windows LAPS local configuration (Config)"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\CI",
        "kind": "recursive",
        "maxDepth": 8,
        "needsAdmin": false,
        "mode": "always",
        "note": "code integrity, Smart App Control state, vulnerable driver blocklist"
      }
    ],
    "keys": [
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\mrxsmb10",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\USBSTOR",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip6\\Parameters",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\EventLog\\Security",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": true,
        "mode": "always",
        "note": "denied without admin on Windows Server 2022/2025 and Windows 11 x64/Arm64 (recorded on the CI runners)"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\EventLog\\System",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\EventLog\\Application",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecureBoot\\State",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\kernel",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\ProductOptions",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "DefaultPassword and AltDefaultPassword are redacted at collection"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\.NETFramework\\v4.0.30319",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\.NETFramework\\v2.0.50727",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\.NETFramework\\v4.0.30319",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "32-bit view"
      },
      {
        "path": "HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\.NETFramework\\v2.0.50727",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "32-bit view"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Cryptography",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "MachineGuid"
        ]
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "kind": "children",
        "maxDepth": 1,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "DisplayName",
          "DisplayVersion",
          "Publisher"
        ],
        "note": "one level of subkeys, only the listed values"
      },
      {
        "path": "HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "kind": "children",
        "maxDepth": 1,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "DisplayName",
          "DisplayVersion",
          "Publisher"
        ],
        "note": "32-bit view; one level of subkeys, only the listed values"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Office\\ClickToRun\\Configuration",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Office\\16.0\\Common\\InstallRoot",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\Office\\16.0\\Common\\InstallRoot",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "32-bit view"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Office\\15.0\\Common\\InstallRoot",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\Office\\15.0\\Common\\InstallRoot",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "32-bit view"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Office\\14.0\\Common\\InstallRoot",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always"
      },
      {
        "path": "HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\Office\\14.0\\Common\\InstallRoot",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "32-bit view"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\W32Time\\Parameters",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "AUD-30: local time source (Type) when no W32Time policy is set"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\W32Time\\TimeProviders\\NtpClient",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "AUD-30: local NTP client (Enabled)"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Policies\\Microsoft\\FVE",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "note": "ENC-07: RDVDenyWriteAccess (the BitLocker CSP ADMX mapping puts it under SYSTEM\\CurrentControlSet\\Policies)"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "PROCESSOR_ARCHITECTURE"
        ],
        "note": "LIFE-05: only PROCESSOR_ARCHITECTURE"
      },
      {
        "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\WinHttp",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "DisableWpad"
        ],
        "note": "NET-05: only DisableWpad"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\RemoteRegistry",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "Start"
        ],
        "note": "start mode only (fallback of the service check without Win32_Service, as in the built-in bundle)"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Spooler",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "Start"
        ],
        "note": "start mode only (fallback of the service check without Win32_Service, as in the built-in bundle)"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\W32Time",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "Start"
        ],
        "note": "start mode only (fallback of the service check without Win32_Service, as in the built-in bundle)"
      },
      {
        "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\wuauserv",
        "kind": "key",
        "maxDepth": 0,
        "needsAdmin": false,
        "mode": "always",
        "values": [
          "Start"
        ],
        "note": "start mode only (fallback of the service check without Win32_Service, as in the built-in bundle)"
      }
    ]
  },
  "wmi": [
