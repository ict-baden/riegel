        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,40}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "$ref": "#/$defs/severity"
