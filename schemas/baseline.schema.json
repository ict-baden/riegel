          "category": {
            "$ref": "#/$defs/category"
          },
          "check": {
            "$ref": "#/$defs/check"
          },
          "rationale": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "check"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "rules"
