{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:catalogue",
  "title": "riegel.catalogue/1 – Catalogue header and packed catalogue",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.catalogue/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}(\\.[1-9]\\d{0,2})?$"
    },
    "releasedOn": {
      "$ref": "#/$defs/date"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycleTable"
    },
    "builds": {
      "$ref": "#/$defs/buildTable"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilityTable"
    },
    "data": {
      "$ref": "#/$defs/catalogueData"
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "releasedOn"
  ],
  "additionalProperties": false,
  "description": "Catalogue header rules/catalogue.json; in an evidence pack the same document carries rules and tables",
  "$defs": {
    "applicability": {
      "type": "object",
      "properties": {
        "os": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "client",
              "server"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minBuild": {
          "type": "integer",
          "minimum": 0
        },
        "maxBuild": {
          "type": "integer",
          "minimum": 0
        },
        "domain": {
          "type": "string",
          "enum": [
            "any",
            "joined",
            "standalone"
          ]
        },
        "excludeDc": {
          "type": "boolean"
        },
        "when": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "in",
                  "notIn"
                ]
              },
              "value": {}
            },
            "required": [
              "fact",
              "op",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "ifCapabilityAbsent": {
          "type": "string",
          "enum": [
            "notApplicable",
            "fail"
          ]
        }
      },
      "required": [
        "os",
        "domain",
        "excludeDc",
        "when"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "capability"
            ]
          },
          "then": {
            "required": [
              "ifCapabilityAbsent"
            ]
          }
        }
      ]
    },
    "auditAction": {
      "type": "object",
      "properties": {
        "guid": {
          "type": "string"
        },
        "subcategory": {
          "type": "string",
          "minLength": 1
        },
        "setting": {
          "type": "string",
          "enum": [
            "none",
            "success",
            "failure",
            "successAndFailure"
          ]
        }
      },
      "required": [
        "guid",
        "subcategory",
        "setting"
      ],
      "additionalProperties": false
    },
    "buildEntry": {
      "type": "object",
      "properties": {
        "build": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ubr": {
                "type": "integer",
                "minimum": 0
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "kb": {
                "type": "string",
                "pattern": "^KB\\d+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "B",
                  "D",
                  "OOB"
                ]
              }
            },
            "required": [
              "ubr",
              "date"
            ],
            "additionalProperties": false
          }
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "seen": {
          "$ref": "#/$defs/date"
        }
      },
      "required": [
        "build",
        "name",
        "releases",
        "source",
        "seen"
      ],
      "additionalProperties": false
    },
    "buildTable": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "riegel.builds/1"
        },
        "builds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildEntry"
          }
        }
      },
      "required": [
        "schema",
        "builds"
      ],
      "additionalProperties": false
    },
    "capabilityEntry": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "exists": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "os": {
                "type": "string",
                "enum": [
                  "client",
                  "server"
                ]
              },
              "minBuild": {
                "type": "integer",
                "minimum": 0
              },
              "maxBuild": {
                "type": "integer",
                "minimum": 0
              },
              "minUbr": {
                "type": "integer",
                "minimum": 0
              },
              "editions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "installationTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "seen": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "capability",
        "exists",
        "source",
        "seen"
      ],
      "additionalProperties": false
    },
    "capabilityTable": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityEntry"
          }
        }
      },
      "required": [
        "capabilities"
      ],
      "additionalProperties": false
    },
    "catalogueData": {
      "type": "object",
      "properties": {
        "remoteAccessTools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/remoteAccessTool"
          }
        },
        "officeDetection": {
          "$ref": "#/$defs/officeDetection"
        }
      },
      "required": [
        "remoteAccessTools"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "enum": [
        "lifecycle",
        "network",
        "credentials",
        "logon",
        "accounts",
        "userRights",
        "defender",
        "appControl",
        "encryption",
        "firewall",
        "services",
        "system",
        "audit",
        "powershell",
        "rdp",
        "media",
        "tls"
      ]
    },
    "check": {
      "oneOf": [
        {
          "$ref": "#/$defs/check_registry"
        },
        {
          "$ref": "#/$defs/check_registryEffective"
        },
        {
          "$ref": "#/$defs/check_secedit"
        },
        {
          "$ref": "#/$defs/check_accountPolicy"
        },
        {
          "$ref": "#/$defs/check_auditSubcategory"
        },
        {
          "$ref": "#/$defs/check_userRight"
        },
        {
          "$ref": "#/$defs/check_service"
        },
        {
          "$ref": "#/$defs/check_feature"
        },
        {
          "$ref": "#/$defs/check_wmiProperty"
        },
        {
          "$ref": "#/$defs/check_defenderSetting"
        },
        {
          "$ref": "#/$defs/check_asrRule"
        },
        {
          "$ref": "#/$defs/check_firewallProfile"
        },
        {
          "$ref": "#/$defs/check_firewallExposure"
        },
        {
          "$ref": "#/$defs/check_lifecycle"
        },
        {
          "$ref": "#/$defs/check_updateAge"
        },
        {
          "$ref": "#/$defs/check_lsaProtection"
        },
        {
          "$ref": "#/$defs/check_deviceGuard"
        },
        {
          "$ref": "#/$defs/check_avStatus"
        },
        {
          "$ref": "#/$defs/check_localAccount"
        },
        {
          "$ref": "#/$defs/check_localAccounts"
        },
        {
          "$ref": "#/$defs/check_localGroup"
        },
        {
          "$ref": "#/$defs/check_inventory"
        },
        {
          "$ref": "#/$defs/check_firstOf"
        },
        {
          "$ref": "#/$defs/check_allOf"
        },
        {
          "$ref": "#/$defs/check_anyOf"
        },
        {
          "$ref": "#/$defs/check_noneOf"
        },
        {
          "$ref": "#/$defs/check_not"
        }
      ],
      "description": "closed check vocabulary (docs/file-formats.md), discriminated by 'type'"
    },
    "check_accountPolicy": {
      "type": "object",
      "properties": {
        "type": {
          "const": "accountPolicy"
        },
        "field": {
          "type": "string",
          "enum": [
            "minPwLen",
            "maxPwAgeDays",
            "minPwAgeDays",
            "pwHistLen",
            "lockoutThreshold",
            "lockoutDurationMin",
            "lockoutWindowMin",
            "passwordComplexity",
            "clearTextPassword"
          ]
        },
        "op": {
          "$ref": "#/$defs/operator"
        },
        "expected": {}
      },
      "required": [
        "type",
        "field",
        "op"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "not": {
                  "enum": [
                    "exists",
                    "notExists"
                  ]
                }
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "expected"
            ]
          }
        }
      ]
    },
    "check_allOf": {
      "type": "object",
      "properties": {
        "type": {
          "const": "allOf"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "checks"
      ],
      "additionalProperties": false
    },
    "check_anyOf": {
      "type": "object",
      "properties": {
        "type": {
          "const": "anyOf"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "checks"
      ],
      "additionalProperties": false
    },
    "check_asrRule": {
      "type": "object",
      "properties": {
        "type": {
          "const": "asrRule"
        },
        "guid": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "accept": {
          "type": "string",
          "enum": [
            "block",
            "blockOrWarn",
            "blockOrAudit"
          ]
        }
      },
      "required": [
        "type",
        "guid"
      ],
      "additionalProperties": false
    },
    "check_auditSubcategory": {
      "type": "object",
      "properties": {
        "type": {
          "const": "auditSubcategory"
        },
        "guid": {
          "type": "string",
          "pattern": "^\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}$"
        },
        "expected": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "successAndFailure",
            "includesSuccess",
            "includesFailure",
            "noAuditing"
          ]
        }
      },
      "required": [
        "type",
        "guid",
        "expected"
      ],
      "additionalProperties": false
    },
    "check_avStatus": {
      "type": "object",
      "properties": {
        "type": {
          "const": "avStatus"
        },
        "maxSignatureAgeDays": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "check_defenderSetting": {
      "type": "object",
      "properties": {
        "type": {
          "const": "defenderSetting"
        },
        "source": {
          "type": "string",
          "enum": [
            "status",
            "preference"
          ]
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "$ref": "#/$defs/operator"
        },
        "expected": {}
      },
      "required": [
        "type",
        "source",
        "property",
        "op"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "not": {
                  "enum": [
                    "exists",
                    "notExists"
                  ]
                }
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "expected"
            ]
          }
        }
      ]
    },
    "check_deviceGuard": {
      "type": "object",
      "properties": {
        "type": {
          "const": "deviceGuard"
        },
        "service": {
          "type": "string",
          "enum": [
            "credentialGuard",
            "hvci",
            "vbs"
          ]
        },
        "requireRunning": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "service"
      ],
      "additionalProperties": false
    },
    "check_feature": {
      "type": "object",
      "properties": {
        "type": {
          "const": "feature"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "installState": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "minItems": 1
        },
        "ifAbsent": {
          "type": "string",
          "enum": [
            "fail",
            "pass",
            "notApplicable"
          ]
        }
      },
      "required": [
        "type",
        "name",
        "installState",
        "ifAbsent"
      ],
      "additionalProperties": false
    },
    "check_firewallExposure": {
      "type": "object",
      "properties": {
        "type": {
          "const": "firewallExposure"
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "protocol": {
                "type": "string",
                "enum": [
                  "tcp",
                  "udp"
                ]
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "protocol",
              "port"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "profiles": {
          "type": "string",
          "enum": [
            "active",
            "all"
          ]
        }
      },
      "required": [
        "type",
        "ports",
        "profiles"
      ],
      "additionalProperties": false
    },
    "check_firewallProfile": {
      "type": "object",
      "properties": {
        "type": {
          "const": "firewallProfile"
        },
        "profile": {
          "type": "string",
          "enum": [
            "domain",
            "private",
            "public"
          ]
        },
        "property": {
          "type": "string",
          "enum": [
            "enabled",
            "defaultInboundBlock",
            "logDropped",
            "allowLocalRules"
          ]
        },
        "expected": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "profile",
        "property",
        "expected"
      ],
      "additionalProperties": false
    },
    "check_firstOf": {
      "type": "object",
      "properties": {
        "type": {
          "const": "firstOf"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "checks"
      ],
      "additionalProperties": false
    },
    "check_inventory": {
      "type": "object",
      "properties": {
        "type": {
          "const": "inventory"
        },
        "renderer": {
          "type": "string",
          "enum": [
            "localAdmins",
            "remoteAccessTools",
            "rdpState",
            "defenderExclusions",
            "shares",
            "adminShares",
            "networkFacts",
            "appControlState",
            "wireless"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(reg|wmi|api|evt|raw|parsed):"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "renderer",
        "items"
      ],
      "additionalProperties": false
    },
    "check_lifecycle": {
      "type": "object",
      "properties": {
        "type": {
          "const": "lifecycle"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "check_localAccount": {
      "type": "object",
      "properties": {
        "type": {
          "const": "localAccount"
        },
        "rid": {
          "type": "integer",
          "minimum": 0
        },
        "expect": {
          "type": "string",
          "enum": [
            "disabled"
          ]
        }
      },
      "required": [
        "type",
        "rid",
        "expect"
      ],
      "additionalProperties": false
    },
    "check_localAccounts": {
      "type": "object",
      "properties": {
        "type": {
          "const": "localAccounts"
        },
        "condition": {
          "type": "string",
          "enum": [
            "passwordNeverExpires",
            "unusedDays",
            "passwordNotRequired"
          ]
        },
        "excludeRids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "enabledOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "condition"
      ],
      "additionalProperties": false
    },
    "check_localGroup": {
      "type": "object",
      "properties": {
        "type": {
          "const": "localGroup"
        },
        "sid": {
          "type": "string",
          "pattern": "^S-1(-\\d+)+$"
        },
        "maxMembers": {
          "type": "integer",
          "minimum": 0
        },
        "allowedSids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(S-1(-\\d+)+|\\*-\\d+)$"
          }
        }
      },
      "required": [
        "type",
        "sid"
      ],
      "additionalProperties": false
    },
    "check_lsaProtection": {
      "type": "object",
      "properties": {
        "type": {
          "const": "lsaProtection"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "check_noneOf": {
      "type": "object",
      "properties": {
        "type": {
          "const": "noneOf"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "checks"
      ],
      "additionalProperties": false
    },
    "check_not": {
      "type": "object",
      "properties": {
        "type": {
          "const": "not"
        },
        "check": {
          "$ref": "#/$defs/check"
        }
      },
      "required": [
        "type",
        "check"
      ],
      "additionalProperties": false
    },
    "check_registry": {
      "type": "object",
      "properties": {
        "type": {
          "const": "registry"
        },
        "key": {
          "type": "string",
          "pattern": "^HKLM\\\\"
        },
        "value": {
          "type": "string"
        },
        "valueType": {
          "$ref": "#/$defs/regValueType"
        },
        "acceptTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regValueType"
          }
        },
        "op": {
          "$ref": "#/$defs/operator"
        },
        "expected": {},
        "whenMissing": {
          "$ref": "#/$defs/whenMissing"
        },
        "osDefaults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/osDefault"
          },
          "minItems": 1
        },
        "missingPass": {
          "$ref": "#/$defs/missingPass"
        },
        "multiSz": {
          "type": "string",
          "enum": [
            "set",
            "list"
          ]
        }
      },
      "required": [
        "type",
        "key",
        "value",
        "valueType",
        "op",
        "whenMissing"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "whenMissing": {
                "const": "osDefault"
              }
            },
            "required": [
              "whenMissing"
            ]
          },
          "then": {
            "required": [
              "osDefaults"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "whenMissing": {
                "const": "pass"
              }
            },
            "required": [
              "whenMissing"
            ]
          },
          "then": {
            "required": [
              "missingPass"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "not": {
                  "enum": [
                    "exists",
                    "notExists"
                  ]
                }
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "expected"
            ]
          }
        }
      ]
    },
    "check_registryEffective": {
      "type": "object",
      "properties": {
        "type": {
          "const": "registryEffective"
