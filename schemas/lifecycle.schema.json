{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:lifecycle",
  "title": "riegel.lifecycle/1 – End of support per Windows product (rules/lifecycle/windows.json)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.lifecycle/1"
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleEntry"
      }
    }
  },
  "required": [
    "schema",
    "products"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (yyyy-MM-dd)"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "lifecycleEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "enum": [
            "client",
            "server"
          ]
        },
        "build": {
          "type": "integer",
          "minimum": 0
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "installationTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channel": {
          "type": "string"
        },
        "mainstreamEnd": {
          "$ref": "#/$defs/date"
        },
        "endOfSupport": {
          "$ref": "#/$defs/date"
        },
        "esuEnd": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "seen": {
          "$ref": "#/$defs/date"
        },
        "crossCheck": {
          "$ref": "#/$defs/httpsUrl"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "os",
        "build",
        "endOfSupport",
        "source",
        "seen"
      ],
      "additionalProperties": false
    }
  }
}
