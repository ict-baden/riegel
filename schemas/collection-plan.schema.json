{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:collection-plan",
  "title": "riegel.collection-plan/1 – Collection plan contracts/collection-plan.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.collection-plan/1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxValuesTotal": {
          "type": "integer",
          "minimum": 0
        },
        "recursiveMaxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "maxBinaryBytes": {
          "type": "integer",
          "minimum": 0
        },
        "toolTimeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "maxRawTextBytes": {
          "type": "integer",
          "minimum": 0
        },
        "windowsUpdateHistoryEntries": {
          "type": "integer",
          "minimum": 0
        },
        "tempPathMaxChars": {
          "type": "integer",
          "minimum": 0
        },
        "maxStringChars": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "maxValuesTotal",
        "recursiveMaxDepth",
        "maxBinaryBytes",
        "toolTimeoutSeconds",
        "maxRawTextBytes",
        "windowsUpdateHistoryEntries",
        "tempPathMaxChars",
        "maxStringChars"
      ],
      "additionalProperties": false
    },
    "registry": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registryPlanEntry"
          }
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registryPlanEntry"
          }
        }
      },
      "required": [
        "roots",
        "keys"
      ],
      "additionalProperties": false
    },
    "wmi": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^wmi:"
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string"
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "adminOnlyProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "static",
                    "perRow"
                  ]
                },
                "viaClass": {
                  "type": "string"
                },
                "keyProperty": {
                  "type": "string"
                },
                "outProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "needsAdmin": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "always",
              "skipInMinimal",
              "deepOnly"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "namespace",
          "class",
          "properties",
          "methods",
          "needsAdmin",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "api": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^api:"
          },
          "api": {
            "type": "string",
            "minLength": 1
          },
          "needsAdmin": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "always",
              "skipInMinimal",
              "deepOnly"
            ]
          },
          "rights": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^Se[A-Za-z]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "sid": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "api",
          "needsAdmin",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^evt:"
          },
          "log": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "type": "integer",
            "minimum": 0
          },
          "xpath": {
            "type": "string",
            "minLength": 1
          },
          "afterLastBoot": {
            "type": "boolean"
          },
          "needsAdmin": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "always",
              "skipInMinimal",
              "deepOnly"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "log",
          "provider",
          "eventId",
          "xpath",
          "afterLastBoot",
          "needsAdmin",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "raw": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^raw:"
          },
          "kind": {
            "type": "string",
            "enum": [
              "tool",
              "file"
            ]
          },
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 0
          },
          "needsAdmin": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "always",
              "skipInMinimal",
              "deepOnly"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "kind",
          "maxBytes",
          "needsAdmin",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "allowedWmiMethods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "$ref": "#/$defs/httpsUrl"
          },
          "seen": {
            "$ref": "#/$defs/date"
          }
        },
        "required": [
          "topic",
          "url",
          "seen"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "version",
    "limits",
    "registry",
    "wmi",
    "api",
    "events",
    "raw",
    "allowedWmiMethods",
    "sources"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (yyyy-MM-dd)"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "registryPlanEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^HKLM\\\\"
        },
        "kind": {
          "type": "string",
          "enum": [
            "recursive",
            "key",
            "children"
          ]
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "needsAdmin": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "always",
            "skipInMinimal",
            "deepOnly"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "maxDepth",
        "needsAdmin",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
