{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:approved",
  "title": "riegel.approved/1 – Approved state of a machine (spec 2.14)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.approved/1"
    },
    "hostName": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "$ref": "#/$defs/runId"
    },
    "snapshotSha256": {
      "$ref": "#/$defs/sha256"
    },
    "resultsSha256": {
      "$ref": "#/$defs/sha256"
    },
    "catalogueVersion": {
      "type": "string",
      "minLength": 1
    },
    "registers": {
      "$ref": "#/$defs/registerHashes"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    }
  },
  "required": [
    "schema",
    "hostName",
    "runId",
    "snapshotSha256",
    "resultsSha256",
    "catalogueVersion",
    "registers",
    "approval"
  ],
  "additionalProperties": false,
  "$defs": {
    "approval": {
      "type": "object",
      "properties": {
        "approvedByRole": {
          "type": "string"
        },
        "approvedByName": {
          "type": "string"
        },
        "approvedOn": {
          "$ref": "#/$defs/date"
        },
        "reviewBy": {
          "$ref": "#/$defs/date"
        },
        "approvalRecord": {
          "type": "string"
        },
        "approvedContentSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (yyyy-MM-dd)"
    },
    "registerHashes": {
      "type": "object",
      "properties": {
        "exceptions": {
          "$ref": "#/$defs/sha256OrEmpty"
        },
        "tailoring": {
          "$ref": "#/$defs/sha256OrEmpty"
        },
        "measures": {
          "$ref": "#/$defs/sha256OrEmpty"
        }
      },
      "required": [
        "exceptions",
        "tailoring",
        "measures"
      ],
      "additionalProperties": false
    },
    "runId": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z-[0-9a-f]{6}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256OrEmpty": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$",
      "description": "empty = register does not exist"
    }
  }
}
