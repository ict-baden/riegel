{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:plant",
  "title": "riegel.plant/1 – Plant file riegel-plant.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.plant/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "other",
              "hmi",
              "engineeringStation",
              "historian",
              "server",
              "office",
              "jumpHost"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hostName": {
            "type": "string",
            "minLength": 1
          },
          "groupId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "esuCovered": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "identity": {
            "$ref": "#/$defs/machineIdentity"
          }
        },
        "required": [
          "hostName",
          "esuCovered"
        ],
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "warnDays": {
          "type": "integer",
          "minimum": 0
        },
        "staleDays": {
          "type": "integer",
          "minimum": 0
        },
        "updateMaxDays": {
          "type": "integer",
          "minimum": 0
        },
        "unusedAccountDays": {
          "type": "integer",
          "minimum": 0
        },
        "confidentiality": {
          "type": "string"
        },
        "signOff": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signOffRole"
          }
        },
        "reportLanguage": {
          "$ref": "#/$defs/language"
        },
        "reportPreset": {
          "type": "string",
          "enum": [
            "audit",
            "asDelivered"
          ]
        },
        "performedBy": {
          "type": "string"
        },
        "coverLogoFile": {
          "type": "string"
        },
        "riskAcceptanceRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operatorRole": {
          "type": "string"
        }
      },
      "required": [
        "warnDays",
        "staleDays",
        "updateMaxDays",
        "unusedAccountDays",
        "signOff",
        "reportPreset",
        "riskAcceptanceRoles"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "groups",
    "machines",
    "settings"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (yyyy-MM-dd)"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "de",
        "es",
        "fr",
        "zh-Hans"
      ]
    },
    "machineIdentity": {
      "type": "object",
      "properties": {
        "machineType": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        },
        "orderNumber": {
          "type": "string"
        },
        "deliveryDate": {
          "$ref": "#/$defs/date"
        },
        "plantSoftware": {
          "type": "string"
        },
        "builder": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signOffRole": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "created",
            "reviewed",
            "approved",
            "accepted"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "step",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
