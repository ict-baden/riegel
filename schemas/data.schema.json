{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:data",
  "title": "riegel.data/1 – Rule data lists (rules/data/*.json)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.data/1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "remoteAccessTools",
        "officeDetection"
      ]
    },
    "remoteAccessTools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/remoteAccessTool"
      }
    },
    "officeDetection": {
      "$ref": "#/$defs/officeDetection"
    }
  },
  "required": [
    "schema",
    "kind"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "remoteAccessTools"
          }
        }
      },
      "then": {
        "required": [
          "remoteAccessTools"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "officeDetection"
          }
        }
      },
      "then": {
        "required": [
          "officeDetection"
        ]
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (yyyy-MM-dd)"
    },
    "detectionKey": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^HKLM\\\\"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "seen": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    },
    "detectionPattern": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "seen": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "officeDetection": {
      "type": "object",
      "properties": {
        "clickToRunKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detectionKey"
          }
        },
        "installRootKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detectionKey"
          }
        },
        "uninstallDisplayNamePrefixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detectionPattern"
          }
        }
      },
      "required": [
        "clickToRunKeys",
        "installRootKeys",
        "uninstallDisplayNamePrefixes"
      ],
      "additionalProperties": false
    },
    "remoteAccessTool": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "serviceNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "displayNameContains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "seen": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "product",
        "serviceNames",
        "displayNameContains",
        "source",
        "seen"
      ],
      "additionalProperties": false
    }
  }
}
