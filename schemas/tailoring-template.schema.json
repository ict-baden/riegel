{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:tailoring-template",
  "title": "riegel.tailoring-template/1 – Tailoring template *.tailoring-template.json (without approval)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.tailoring-template/1"
    },
    "plantId": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tailoringTemplateEntry"
      }
    }
  },
  "required": [
    "schema",
    "plantId",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (yyyy-MM-dd)"
    },
    "emptyApproval": {
      "type": "object",
      "maxProperties": 0,
      "description": "templates carry no approval"
    },
    "registerScope": {
      "type": "object",
      "properties": {
        "machines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allMachines": {
          "type": "boolean"
        }
      },
      "required": [
        "machines",
        "groups",
        "allMachines"
      ],
      "additionalProperties": false
    },
    "tailoringTemplateEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TL-\\d{4,}$"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/registerScope"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "$ref": "#/$defs/emptyApproval"
        },
        "createdOn": {
          "$ref": "#/$defs/date"
        },
        "createdByRole": {
          "type": "string"
        },
        "modifiedOn": {
          "$ref": "#/$defs/date"
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ruleId",
        "scope",
        "reason",
        "approval",
        "createdOn"
      ],
      "additionalProperties": false
    }
  }
}
