{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:measures",
  "title": "riegel.measures/1 – Measures register (spec 2.13)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.measures/1"
    },
    "plantId": {
      "type": "string",
      "minLength": 1
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measureEntry"
      }
    }
  },
  "required": [
    "schema",
    "plantId",
    "measures"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (yyyy-MM-dd)"
    },
    "measureEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M-\\d{4,}$"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/registerScope"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1
        },
        "dueDate": {
          "$ref": "#/$defs/date"
        },
        "ticket": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "planned",
            "done",
            "dropped"
          ]
        },
        "createdOn": {
          "$ref": "#/$defs/date"
        },
        "createdByRole": {
          "type": "string"
        },
        "modifiedOn": {
          "$ref": "#/$defs/date"
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ruleId",
        "scope",
        "action",
        "ownerRole",
        "dueDate",
        "state",
        "createdOn"
      ],
      "additionalProperties": false
    },
    "registerScope": {
      "type": "object",
      "properties": {
        "machines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allMachines": {
          "type": "boolean"
        }
      },
      "required": [
        "machines",
        "groups",
        "allMachines"
      ],
      "additionalProperties": false
    }
  }
}
