{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ict-baden:riegel:schema:exceptions-template",
  "title": "riegel.exceptions-template/1 – Exception template *.exceptions-template.json (without approval)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "riegel.exceptions-template/1"
    },
    "plantId": {
      "type": "string",
      "minLength": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exceptionTemplateEntry"
      }
    }
  },
  "required": [
    "schema",
    "plantId",
    "exceptions"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (yyyy-MM-dd)"
    },
    "emptyApproval": {
      "type": "object",
      "maxProperties": 0,
      "description": "templates carry no approval"
    },
    "exceptionTemplateEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EX-\\d{4,}$"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/registerScope"
        },
        "category": {
          "$ref": "#/$defs/reasonCategory"
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "compensatingMeasure": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "acceptedValue": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/emptyApproval"
        },
        "createdOn": {
          "$ref": "#/$defs/date"
        },
        "createdByRole": {
          "type": "string"
        },
        "modifiedOn": {
          "$ref": "#/$defs/date"
        },
        "catalogueVersion": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ruleId",
        "scope",
        "category",
        "justification",
        "approval",
        "createdOn"
      ],
      "additionalProperties": false
    },
    "reasonCategory": {
      "type": "string",
      "enum": [
        "vendorRequirement",
        "technicalNecessity",
        "compensatingControl",
        "riskAccepted",
        "notRelevantHere"
      ]
    },
    "registerScope": {
      "type": "object",
      "properties": {
        "machines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allMachines": {
          "type": "boolean"
        }
      },
      "required": [
        "machines",
        "groups",
        "allMachines"
      ],
      "additionalProperties": false
    }
  }
}
